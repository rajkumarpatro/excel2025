<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --jbp-maroon: #5a0000; /* Corporate Professional Maroon */
        --jbp-gold: #c5a059;
        --glass-bg: rgba(255, 255, 255, 0.85);
        --glass-border: rgba(255, 255, 255, 0.4);
    }

    body {
        font-family: 'Poppins', sans-serif;
        background-color: #fcfcfc;
    }

    /* Professional Hero Section */
    .hero-jbp-cs {
        background: linear-gradient(135deg, var(--jbp-maroon) 0%, #2a0000 100%);
        padding: 100px 0;
        color: white;
        border-radius: 0 0 100px 0;
        position: relative;
        overflow: hidden;
    }

        .hero-jbp-cs::before {
            content: "";
            position: absolute;
            top: -10%;
            right: -10%;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(197, 160, 89, 0.15) 0%, transparent 70%);
            animation: pulse-glow 8s infinite alternate;
        }

    @@keyframes pulse-glow {
        from {
            transform: scale(1);
            opacity: 0.5;
        }

        to {
            transform: scale(1.2);
            opacity: 0.8;
        }
    }

    /* Glassmorphism Feature Cards */
    .glass-card-cs {
        background: var(--glass-bg);
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        border: 1px solid var(--glass-border);
        border-radius: 30px;
        padding: 40px;
        transition: all 0.4s ease;
        height: 100%;
        box-shadow: 0 15px 35px rgba(0,0,0,0.05);
    }

        .glass-card-cs:hover {
            transform: translateY(-15px);
            background: #ffffff;
            box-shadow: 0 25px 50px rgba(90, 0, 0, 0.1);
            border-color: var(--jbp-gold);
        }

    .icon-box-cs {
        width: 70px;
        height: 70px;
        background: var(--jbp-maroon);
        color: white;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 25px;
        font-size: 1.8rem;
        transition: 0.5s;
    }

    .glass-card-cs:hover .icon-box-cs {
        background: var(--jbp-gold);
        transform: rotateY(180deg);
        color: #000;
    }

    /* Action Buttons */
    .btn-jbp-cs {
        background: var(--jbp-gold);
        color: #000;
        font-weight: 700;
        padding: 15px 40px;
        border-radius: 50px;
        text-transform: uppercase;
        border: none;
        transition: 0.3s;
    }

        .btn-jbp-cs:hover {
            background: #b38b4d;
            box-shadow: 0 10px 20px rgba(197, 160, 89, 0.4);
            transform: translateY(-3px);
            color: #fff;
        }

    .contact-item-blp {
        background: rgba(255, 255, 255, 0.1);
        padding: 15px 25px;
        border-radius: 15px;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        border: 1px solid rgba(255, 255, 255, 0.2);
        transition: 0.3s;
        cursor: pointer;
    }

        .contact-item-blp:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: translateX(10px);
            border-color: var(--jbp-gold);
        }
</style>

