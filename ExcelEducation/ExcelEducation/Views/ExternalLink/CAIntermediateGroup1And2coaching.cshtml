<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --ca-navy: #001f3f;
        --ca-gold: #ffcc00;
        --ca-accent: #007bff;
        --glass-bg: rgba(255, 255, 255, 0.9);
        --glass-border: rgba(255, 255, 255, 0.5);
    }

    body {
        font-family: 'Poppins', sans-serif;
        background-color: #f0f4f8;
        color: #333;
    }

    /* Professional Hero Section */
    .hero-ca-inter {
        background: linear-gradient(135deg, var(--ca-navy) 0%, #001226 100%);
        padding: 120px 0;
        color: white;
        border-radius: 0 0 100px 0;
        position: relative;
        overflow: hidden;
    }

        .hero-ca-inter::before {
            content: "";
            position: absolute;
            top: -10%;
            left: -10%;
            width: 100%;
            height: 120%;
            background: radial-gradient(circle, rgba(255, 204, 0, 0.1) 0%, transparent 60%);
            animation: glow-pulse 10s infinite alternate;
        }

    @@keyframes glow-pulse {
        from {
            opacity: 0.3;
            transform: scale(1);
        }

        to {
            opacity: 0.6;
            transform: scale(1.1);
        }
    }

    /* Glassmorphism Subject Cards */
    .glass-card-inter {
        background: var(--glass-bg);
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        border: 1px solid var(--glass-border);
        border-radius: 30px;
        padding: 35px;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        height: 100%;
        box-shadow: 0 15px 35px rgba(0,0,0,0.05);
    }

        .glass-card-inter:hover {
            transform: translateY(-15px);
            background: #ffffff;
            box-shadow: 0 25px 50px rgba(0, 31, 63, 0.1);
            border-color: var(--ca-gold);
        }

    .icon-badge {
        width: 70px;
        height: 70px;
        background: var(--ca-navy);
        color: white;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 25px;
        font-size: 1.8rem;
    }

    /* Premium Buttons */
    .btn-ca-premium {
        background: var(--ca-gold);
        color: #000;
        font-weight: 700;
        padding: 16px 45px;
        border-radius: 50px;
        text-transform: uppercase;
        border: none;
        transition: 0.3s;
        letter-spacing: 1px;
    }

        .btn-ca-premium:hover {
            background: #e6b800;
            box-shadow: 0 12px 25px rgba(255, 204, 0, 0.4);
            transform: scale(1.05);
            color: #000;
        }

    .contact-bubble-inter {
        background: rgba(255, 255, 255, 0.1);
        padding: 18px 25px;
        border-radius: 20px;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        border: 1px solid rgba(255, 255, 255, 0.2);
        transition: 0.3s;
        cursor: pointer;
    }

        .contact-bubble-inter:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: translateX(10px);
            border-color: var(--ca-gold);
        }
</style>

