@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Best CS Foundation (CSEET) Coaching in Bhilai | Top CS Classes";
    ViewData["Description"] = "Join Bhilai's best CS Foundation coaching. Expert faculty, result-oriented smart learning, and highest pass rate. Affordable fees with premium study material. Enroll Today!";
    ViewData["Keywords"] = "CS Foundation coaching Bhilai, CSEET classes in Bhilai, Best Company Secretary coaching, CS institute Bhilai, Trusted CS coaching Chhattisgarh";
}

<!-- Google Fonts & Icons -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --cs-primary: #1e3c72;
        --cs-secondary: #2a5298;
        --accent: #00d2ff;
        --glass-bg: rgba(255, 255, 255, 0.12);
        --glass-border: rgba(255, 255, 255, 0.2);
    }

    body {
        font-family: 'Poppins', sans-serif;
        background: #f0f2f5;
    }

    /* Ultra Modern Hero Section */
    .hero-bhilai {
        background: linear-gradient(135deg, var(--cs-primary) 0%, var(--cs-secondary) 100%);
        padding: 90px 0;
        color: white;
        border-radius: 0 0 100px 0;
        position: relative;
    }

    .hero-glass-panel {
        background: var(--glass-bg);
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        border: 1px solid var(--glass-border);
        border-radius: 30px;
        padding: 40px;
        box-shadow: 0 25px 50px rgba(0,0,0,0.2);
    }

    .badge-ranker {
        background: linear-gradient(90deg, #ff8a00, #e52e71);
        color: white;
        padding: 6px 18px;
        border-radius: 50px;
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        display: inline-block;
        margin-bottom: 15px;
    }

    /* Service Cards */
    .service-card {
        background: white;
        border-radius: 24px;
        padding: 30px;
        border: none;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        transition: all 0.4s ease;
        height: 100%;
        text-align: center;
    }

        .service-card:hover {
            transform: translateY(-12px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.12);
        }

    .icon-box {
        width: 70px;
        height: 70px;
        background: #eef2f7;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        font-size: 1.8rem;
        color: var(--cs-primary);
        transition: 0.3s;
    }

    .service-card:hover .icon-box {
        background: var(--cs-primary);
        color: white;
    }

    .btn-premium {
        background: white;
        color: var(--cs-primary);
        font-weight: 700;
        padding: 15px 40px;
        border-radius: 50px;
        text-transform: uppercase;
        border: none;
        transition: 0.3s;
    }

        .btn-premium:hover {
            background: var(--accent);
            color: white;
            box-shadow: 0 5px 20px rgba(0,210,255,0.4);
        }

    .list-item-custom {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 12px;
        font-weight: 500;
    }
</style>

<div class="container-fluid p-0">
    <!-- Hero -->
    <section class="hero-bhilai">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-7 text-center text-lg-start">
                    <span class="badge-ranker">Bhilai's #1 Coaching for AIR Rankers</span>
                    <h1 class="display-3 text-white fw-bold mb-3">Best CS Foundation <br><span style="color: var(--accent);">CSEET</span> Classes</h1>
                    <p class="lead mb-4 opacity-75">Bhilai ke <span class="fw-bold">Expert Faculty</span> ke sath kariye apni success <span class="fw-bold">Guaranteed</span>. Smart Learning aur Result-Oriented approach ke sath.</p>
                    <div class="d-flex flex-wrap justify-content-center justify-content-lg-start gap-3">
                        <button class="btn btn-premium shadow-lg">Start Learning</button>
                        <button class="btn btn-outline-light rounded-pill px-4">Download Brochure</button>
                    </div>
                </div>
                <div class="col-lg-5 mt-5 mt-lg-0">
                    <div class="hero-glass-panel">
                        <h4 class="fw-bold mb-4 text-center">Get Admission Today!</h4>
                        <p class="text-center small mb-4">Limited Seats Available for New Batch</p>
                        <div class="d-grid gap-3">
                            <div class="list-item-custom"><i class="bi bi-star-fill text-warning"></i> Highest Pass Rate in Chhattisgarh</div>
                            <div class="list-item-custom"><i class="bi bi-mortarboard-fill"></i> Personalized Mentorship</div>
                            <div class="list-item-custom"><i class="bi bi-graph-up-arrow"></i> Career-Focused Training</div>
                            <button class="btn btn-info w-100 mt-3 fw-bold rounded-pill text-white">Book Free Demo</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Features -->
    <div class="container my-5 py-5">
        <div class="text-center mb-5">
            <h2 class="fw-bold">Humari <span class="text-primary">Proven</span> Methodology</h2>
            <p class="text-muted">Trusted by students for Professional CS Preparation in Bhilai</p>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="service-card">
                    <div class="icon-box"><i class="bi bi-display"></i></div>
                    <h4 class="fw-bold">Live Interactive Classes</h4>
                    <p class="text-muted">Real-time doubt clearing sessions ke sath interactive learning ka anubhav.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="service-card">
                    <div class="icon-box"><i class="bi bi-lightning-charge"></i></div>
                    <h4 class="fw-bold">Smart Learning Tools</h4>
                    <p class="text-muted">Advanced study material aur mock tests jo aapko ranker banate hain.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="service-card">
                    <div class="icon-box"><i class="bi bi-wallet2"></i></div>
                    <h4 class="fw-bold">Affordable Scholarship</h4>
                    <p class="text-muted">Quality education ab har student ke liye accessible aur affordable hai.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Call to Action -->
    <div class="container mb-5">
        <div class="p-5 rounded-5 bg-white shadow-lg border border-light position-relative overflow-hidden">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <h2 class="fw-bold">Join the <span class="text-primary">Top</span> CS Coaching in Bhilai</h2>
                    <p class="mb-0 text-muted">Aapki journey Company Secretary banne ki yahan se start hoti hai. Join New Batch!</p>
                </div>
                <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">
                    <button class="btn btn-primary btn-lg px-5 rounded-pill fw-bold">Enroll Today</button>
                </div>
            </div>

            <hr class="my-5">

            <div class="row text-center g-3">
                <div class="col-6 col-md-3">
                    <h6 class="fw-bold text-primary mb-1">Talk to Counselor</h6>
                    <p class="small text-muted">Free Guidance</p>
                </div>
                <div class="col-6 col-md-3">
                    <h6 class="fw-bold text-primary mb-1">Reserve Your Seat</h6>
                    <p class="small text-muted">Limited Batch</p>
                </div>
                <div class="col-6 col-md-3">
                    <h6 class="fw-bold text-primary mb-1">Successful Apply Now</h6>
                    <p class="small text-muted">Online/Offline</p>
                </div>
                <div class="col-6 col-md-3">
                    <h6 class="fw-bold text-primary mb-1">Join Live Classes</h6>
                    <p class="small text-muted">Hybrid Mode</p>
                </div>
            </div>
        </div>
    </div>
</div>