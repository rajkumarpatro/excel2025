<style>
    :root {
        --cuttack-navy: #002347;
        --cuttack-orange: #ff6600; /* CMA Official Color Theme */
        --glass-white: rgba(255, 255, 255, 0.75);
        --glass-border: rgba(255, 255, 255, 0.4);
    }

    body {
        font-family: 'Poppins', sans-serif;
        background-color: #f8fafc;
        color: #2d3436;
    }

    /* Animated Hero Section */
    .hero-cuttack {
        background: linear-gradient(135deg, var(--cuttack-navy) 0%, #001226 100%);
        padding: 100px 0;
        color: white;
        border-radius: 0 0 80px 0;
        position: relative;
        overflow: hidden;
    }

    .hero-cuttack::before {
        content: "";
        position: absolute;
        top: -50%;
        right: -10%;
        width: 80%;
        height: 180%;
        background: radial-gradient(circle, rgba(255, 102, 0, 0.1) 0%, transparent 70%);
        animation: pulse 10s infinite alternate;
    }
 
    /* Glassmorphism Cards */
    .glass-feature {
        background: var(--glass-white);
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        border: 1px solid var(--glass-border);
        border-radius: 30px;
        padding: 40px;
        transition: all 0.4s ease;
        height: 100%;
        box-shadow: 0 15px 35px rgba(0,0,0,0.05);
    }

    .glass-feature:hover {
        transform: translateY(-12px);
        background: #ffffff;
        border-color: var(--cuttack-orange);
        box-shadow: 0 25px 50px rgba(0,0,0,0.12);
    }

    .icon-box {
        width: 70px;
        height: 70px;
        background: var(--cuttack-navy);
        color: white;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 25px;
        font-size: 1.8rem;
        transition: 0.5s;
    }

    .glass-feature:hover .icon-box {
        background: var(--cuttack-orange);
        transform: rotateY(180deg);
    }

    /* Modern Buttons */
    .btn-cuttack {
        background: var(--cuttack-orange);
        color: white;
        font-weight: 700;
        padding: 15px 35px;
        border-radius: 50px;
        border: none;
        transition: 0.3s;
    }

    .btn-cuttack:hover {
        background: #e65c00;
        transform: translateY(-3px);
        box-shadow: 0 10px 20px rgba(255, 102, 0, 0.3);
        color: white;
    }

    .btn-contact-outline {
        border: 2px solid var(--cuttack-orange);
        color: var(--cuttack-orange);
        border-radius: 50px;
        padding: 12px 30px;
        font-weight: 600;
        transition: 0.3s;
    }

    .btn-contact-outline:hover {
        background: var(--cuttack-orange);
        color: white;
    }
</style>

