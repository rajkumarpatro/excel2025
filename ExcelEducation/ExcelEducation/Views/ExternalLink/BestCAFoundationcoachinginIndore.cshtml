@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = " Best CA Foundation Coaching In Indore";
}

<!-- Google Fonts & Bootstrap Icons -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --indore-blue: #003366;
        --indore-gold: #c5a059;
        --glass-white: rgba(255, 255, 255, 0.7);
        --glass-border: rgba(255, 255, 255, 0.3);
    }

    body {
        font-family: 'Poppins', sans-serif;
        background-color: #f0f4f8;
        color: #333;
    }

    /* Animated Hero Section */
    .hero-indore {
        background: linear-gradient(135deg, var(--indore-blue) 0%, #001a33 100%);
        padding: 100px 0;
        color: white;
        border-radius: 0 0 100px 0;
        position: relative;
        overflow: hidden;
    }

        .hero-indore::before {
            content: "";
            position: absolute;
            top: -50%;
            left: -20%;
            width: 100%;
            height: 200%;
            background: radial-gradient(circle, rgba(197, 160, 89, 0.15) 0%, transparent 60%);
            animation: rotate 20s linear infinite;
        }

    @@keyframes rotate {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    /* Glassmorphism Cards with Hover Animation */
    .glass-feature {
        background: var(--glass-white);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid var(--glass-border);
        border-radius: 25px;
        padding: 35px;
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        height: 100%;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    }

        .glass-feature:hover {
            transform: translateY(-15px);
            background: #ffffff;
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
            border-color: var(--indore-gold);
        }

    .icon-circle {
        width: 60px;
        height: 60px;
        background: var(--indore-blue);
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
        font-size: 1.5rem;
        transition: transform 0.5s ease;
    }

    .glass-feature:hover .icon-circle {
        transform: rotateY(360deg);
        background: var(--indore-gold);
    }

    .btn-indore {
        background: var(--indore-gold);
        color: white;
        font-weight: 700;
        padding: 15px 40px;
        border-radius: 50px;
        text-transform: uppercase;
        border: none;
        transition: 0.3s ease;
        letter-spacing: 1px;
    }

        .btn-indore:hover {
            background: #b38b4d;
            box-shadow: 0 10px 20px rgba(197, 160, 89, 0.4);
            transform: scale(1.05);
            color: white;
        }

    .section-tag {
        color: var(--indore-gold);
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        font-size: 0.85rem;
    }
</style>

