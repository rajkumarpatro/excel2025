@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Best CA Foundation Coaching in Indore | Top CA Institute";
    ViewData["Description"] = "Looking for the Best CA Foundation Coaching in Indore? Excel Educational Institution offers expert faculty, smart learning, and the highest pass rate. Enroll Today!";
    ViewData["Keywords"] = "Best CA Foundation coaching in Indore, CA classes in Indore, Top CA Foundation institute, CA coaching near me, Indore CA Foundation classes";
}

<!-- Google Fonts & Bootstrap Icons -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --indore-blue: #003366;
        --indore-gold: #c5a059;
        --glass-white: rgba(255, 255, 255, 0.7);
        --glass-border: rgba(255, 255, 255, 0.3);
    }

    body {
        font-family: 'Poppins', sans-serif;
        background-color: #f0f4f8;
        color: #333;
    }

    /* Animated Hero Section */
    .hero-indore {
        background: linear-gradient(135deg, var(--indore-blue) 0%, #001a33 100%);
        padding: 100px 0;
        color: white;
        border-radius: 0 0 100px 0;
        position: relative;
        overflow: hidden;
    }

        .hero-indore::before {
            content: "";
            position: absolute;
            top: -50%;
            left: -20%;
            width: 100%;
            height: 200%;
            background: radial-gradient(circle, rgba(197, 160, 89, 0.15) 0%, transparent 60%);
            animation: rotate 20s linear infinite;
        }

    @@keyframes rotate {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    /* Glassmorphism Cards with Hover Animation */
    .glass-feature {
        background: var(--glass-white);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid var(--glass-border);
        border-radius: 25px;
        padding: 35px;
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        height: 100%;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    }

        .glass-feature:hover {
            transform: translateY(-15px);
            background: #ffffff;
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
            border-color: var(--indore-gold);
        }

    .icon-circle {
        width: 60px;
        height: 60px;
        background: var(--indore-blue);
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
        font-size: 1.5rem;
        transition: transform 0.5s ease;
    }

    .glass-feature:hover .icon-circle {
        transform: rotateY(360deg);
        background: var(--indore-gold);
    }

    .btn-indore {
        background: var(--indore-gold);
        color: white;
        font-weight: 700;
        padding: 15px 40px;
        border-radius: 50px;
        text-transform: uppercase;
        border: none;
        transition: 0.3s ease;
        letter-spacing: 1px;
    }

        .btn-indore:hover {
            background: #b38b4d;
            box-shadow: 0 10px 20px rgba(197, 160, 89, 0.4);
            transform: scale(1.05);
            color: white;
        }

    .section-tag {
        color: var(--indore-gold);
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        font-size: 0.85rem;
    }
</style>

<div class="container-fluid p-0">
    <!-- Hero Section -->
    <section class="hero-indore text-center text-lg-start">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-7">
                    <span class="badge bg-light text-dark mb-3 px-3 py-2 rounded-pill fw-bold shadow-sm">
                        <i class="bi bi-geo-alt-fill text-danger"></i> #1 Best Coaching
                    </span>
                    <h1 class="display-3 text-white fw-bold mb-3">Best CA Foundation Coaching in Indore</h1>
                    <p class="lead mb-4 opacity-75">Join the most <span class="fw-bold">Trusted</span> institute in Indore for <span class="fw-bold text-warning">AIR Rankers</span>. Start your CA journey with <span class="fw-bold">Expert Faculty</span> and Smart Learning.</p>
                    <div class="d-flex flex-wrap justify-content-center justify-content-lg-start gap-3">
                        <button class="btn btn-indore shadow-lg">Start Learning</button>
                        <button class="btn btn-outline-light rounded-pill px-4 fw-bold">Book Free Demo</button>
                    </div>
                </div>
                <div class="col-lg-5 mt-5 mt-lg-0 text-center">
                    <div class="p-4 bg-white rounded-5 shadow-lg text-dark">
                        <h4 class="fw-bold mb-3">Join New Batch</h4>
                        <p class="small text-muted">Enroll Today & Get Professional Scholarship</p>
                        <div class="d-grid gap-2">
                            <div class="p-3 border rounded-4 bg-light d-flex align-items-center">
                                <i class="bi bi-check-circle-fill text-success fs-4 me-3"></i>
                                <span class="fw-bold">Highest Pass Rate</span>
                            </div>
                            <div class="p-3 border rounded-4 bg-light d-flex align-items-center">
                                <i class="bi bi-check-circle-fill text-success fs-4 me-3"></i>
                                <span class="fw-bold">Proven Concept Clarity</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <div class="container my-5 py-5">
        <div class="text-center mb-5">
            <span class="section-tag">Premium Experience</span>
            <h2 class="fw-bold display-5 mt-2">Kyun Chunein Indore ki <span class="text-primary">Best</span> Coaching?</h2>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="glass-feature">
                    <div class="icon-circle"><i class="bi bi-mortarboard-fill"></i></div>
                    <h4 class="fw-bold">Expert Faculty</h4>
                    <p class="text-muted">Indore ke top CA professionals dwara concept-based learning aur <span class="fw-bold">Guaranteed</span> doubt clearance.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="glass-feature">
                    <div class="icon-circle"><i class="bi bi-graph-up-arrow"></i></div>
                    <h4 class="fw-bold">Smart Learning</h4>
                    <p class="text-muted">Weekly Mock Tests aur result-oriented analysis jo har student ko <span class="fw-bold">AIR Ranker</span> banane mein madad kare.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="glass-feature">
                    <div class="icon-circle"><i class="bi bi-laptop"></i></div>
                    <h4 class="fw-bold">Hybrid Classes</h4>
                    <p class="text-muted"><span class="fw-bold">Live & Interactive</span> classes ke saath Recorded Lectures ka backup bhi available.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- CTA & SEO Keywords -->
    <div class="container mb-5">
        <div class="p-5 rounded-5 bg-dark text-white text-center shadow-lg position-relative overflow-hidden">
            <div class="position-relative z-1">
                <h2 class="fw-bold mb-3">Ready for a <span class="text-warning">Career-Focused</span> Future?</h2>
                <p class="mb-4 opacity-75">Talk to Counselor today for <span class="fw-bold text-white">Free Guidance</span> and Reserve Your Seat.</p>
                <div class="d-flex flex-wrap justify-content-center gap-3">
                    <button class="btn btn-indore px-5">Successful Apply Now</button>
                    <button class="btn btn-outline-warning rounded-pill px-5 fw-bold">Download Brochure</button>
                </div>

                <div class="mt-5 pt-4 border-top border-secondary">
                    <div class="row g-2 justify-content-center">
                        <div class="col-auto"><span class="badge border border-secondary p-2">CA Coaching Indore</span></div>
                        <div class="col-auto"><span class="badge border border-secondary p-2">Top CA Foundation Institute</span></div>
                        <div class="col-auto"><span class="badge border border-secondary p-2">Advanced Commerce Preparation</span></div>
                        <div class="col-auto"><span class="badge border border-secondary p-2">Personalized Mentorship</span></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>