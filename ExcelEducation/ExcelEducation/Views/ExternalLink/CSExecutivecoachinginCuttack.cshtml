<style>
    :root {
        --cuttack-maroon: #4a0000; /* Corporate CS Identity */
        --cuttack-silver: #e5e7eb;
        --glass-white: rgba(255, 255, 255, 0.85);
        --glass-border: rgba(255, 255, 255, 0.4);
    }

    body {
        font-family: 'Poppins', sans-serif;
        background-color: #f3f4f6;
    }

    /* Executive Hero Section */
    .hero-cuttack-cs {
        background: linear-gradient(135deg, var(--cuttack-maroon) 0%, #200000 100%);
        padding: 100px 0;
        color: white;
        border-radius: 0 0 100px 0;
        position: relative;
        overflow: hidden;
    }

        .hero-cuttack-cs::after {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: radial-gradient(circle at 70% 30%, rgba(255, 255, 255, 0.05) 0%, transparent 50%);
        }

    /* Glassmorphism Logic Cards */
    .glass-card-cs {
        background: var(--glass-white);
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        border: 1px solid var(--glass-border);
        border-radius: 30px;
        padding: 40px;
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        height: 100%;
        box-shadow: 0 15px 35px rgba(0,0,0,0.05);
    }

        .glass-card-cs:hover {
            transform: translateY(-12px);
            background: #ffffff;
            box-shadow: 0 25px 50px rgba(74, 0, 0, 0.1);
            border-color: #800000;
        }

    .icon-badge-cs {
        width: 70px;
        height: 70px;
        background: var(--cuttack-maroon);
        color: white;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 25px;
        font-size: 1.8rem;
        transition: 0.5s;
    }

    .glass-card-cs:hover .icon-badge-cs {
        transform: rotateY(180deg);
        background: #800000;
    }

    /* Action Buttons */
    .btn-executive {
        background: #ffffff;
        color: var(--cuttack-maroon);
        font-weight: 700;
        padding: 15px 40px;
        border-radius: 50px;
        text-transform: uppercase;
        border: none;
        transition: 0.3s;
    }

        .btn-executive:hover {
            background: #f8d7da;
            transform: scale(1.05);
            color: var(--cuttack-maroon);
        }

    .contact-bubble {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        padding: 18px;
        border-radius: 20px;
        margin-bottom: 12px;
        transition: 0.3s;
        cursor: pointer;
    }

        .contact-bubble:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: translateX(10px);
        }
</style>

