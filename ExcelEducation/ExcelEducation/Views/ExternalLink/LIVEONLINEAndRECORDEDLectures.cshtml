        position: relative;
        overflow: hidden;
        border-radius: 0 0 50px 50px;
    }

        .hero-section::before {
            content: '';
            position: absolute;
            width: 400px;
            height: 400px;
            background: rgba(255,255,255,.08);
            border-radius: 50%;
            top: -150px;
            right: -100px;
        }

        .hero-section::after {
            content: '';
            position: absolute;
            width: 300px;
            height: 300px;
            background: rgba(255,255,255,.05);
            border-radius: 50%;
            bottom: -100px;
            left: -100px;
        }

    .hero-badge {
        display: inline-block;
        background: #ffffff;
        color: #0d6efd;
        padding: 10px 22px;
        border-radius: 50px;
        font-size: 14px;
        font-weight: 600;
        letter-spacing: 1px;
        box-shadow: 0 10px 25px rgba(0,0,0,.15);
    }

    .hero-title {
        color: #fff;
        font-size: 30px;
        font-weight: 700;
        line-height: 1.2;
    }

