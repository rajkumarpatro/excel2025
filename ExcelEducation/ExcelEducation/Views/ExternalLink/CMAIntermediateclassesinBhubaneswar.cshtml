    /* Ultra-Modern Hero Section */
    .hero-cma-bbsr {
        background: radial-gradient(circle at top right, #134e4a 0%, #020617 100%);
        padding: 120px 0;
        position: relative;
        overflow: hidden;
        border-bottom: 1px solid var(--glass-border);
    }

        .hero-cma-bbsr::before {
            content: "";
            position: absolute;
            width: 300px;
            height: 300px;
            background: var(--bbsr-primary);
            filter: blur(150px);
            opacity: 0.15;
            bottom: -50px;
            right: -50px;
        }

    /* Glassmorphism Feature Cards */
    .glass-card-bbsr {
        background: var(--glass-bg);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid var(--glass-border);
        border-radius: 24px;
        padding: 35px;
        transition: all 0.4s ease;
        text-align: center;
        height: 100%;
    }

        .glass-card-bbsr:hover {
            transform: translateY(-12px);
            background: rgba(255, 255, 255, 0.08);
            border-color: var(--bbsr-primary);
            box-shadow: 0 20px 40px rgba(0,0,0,0.5);
        }

    .icon-glow-bbsr {
        font-size: 2.5rem;
        color: var(--bbsr-primary);
        margin-bottom: 20px;
        display: inline-block;
        text-shadow: 0 0 20px rgba(13, 148, 136, 0.4);
    }

    /* Buttons */
    .btn-teal {
        background: var(--bbsr-primary);
        color: white;
        font-weight: 700;
        padding: 15px 40px;
        border-radius: 12px;
        border: none;
        transition: 0.3s;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

        .btn-teal:hover {
            background: #14b8a6;
            transform: translateY(-3px);
