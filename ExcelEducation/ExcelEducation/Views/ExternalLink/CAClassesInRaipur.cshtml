<!-- ===================== What is the CA Course ===================== -->
<section class="py-5" id="ca-course">
    <div class="container">

        <div class="row justify-content-center mb-5">
            <div class="col-lg-8 text-center">

                <span class="badge bg-danger px-3 py-2 mb-3">
