        height: 70px;
        background: var(--indore-blue);
        color: white;
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 25px;
        font-size: 1.8rem;
    }

    /* Action Buttons */
    .btn-indore {
