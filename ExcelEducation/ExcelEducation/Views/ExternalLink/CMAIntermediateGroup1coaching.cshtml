@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "CMA Intermediate Group 1 Coaching | Excel Educational Institution";
    ViewData["Description"] = "Expert coaching for CMA Intermediate Group 1. Master Financial Accounting, Law, Taxation, and Costing with Raipur's top faculty.";
    ViewData["Keywords"] = "CMA Intermediate Group 1 coaching, CMA Inter Group 1 classes, CMA Taxation coaching, CMA Costing classes, Excel Education CMA";
}

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --cma-navy: #002b5b;
        --cma-orange: #f37021;
        --glass-bg: rgba(255, 255, 255, 0.9);
        --glass-border: rgba(255, 255, 255, 0.5);
    }

    body {
        font-family: 'Poppins', sans-serif;
        background-color: #f8fafc;
    }

    /* Professional Hero Section */
    .hero-group1 {
        background: linear-gradient(135deg, var(--cma-navy) 0%, #001a33 100%);
        padding: 100px 0;
        color: white;
        border-radius: 0 0 100px 0;
        position: relative;
        overflow: hidden;
    }

        .hero-group1::after {
            content: "";
            position: absolute;
            top: -20%;
            right: -10%;
            width: 400px;
            height: 400px;
            background: rgba(243, 112, 33, 0.15);
            border-radius: 50%;
            filter: blur(80px);
        }

    /* Subject Cards with Hover Effect */
    .subject-card {
        background: var(--glass-bg);
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        border: 1px solid var(--glass-border);
        border-radius: 25px;
        padding: 30px;
        transition: all 0.4s ease;
        height: 100%;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    }

        .subject-card:hover {
            transform: translateY(-10px);
            border-color: var(--cma-orange);
            box-shadow: 0 20px 40px rgba(243, 112, 33, 0.1);
        }

    .icon-box {
        width: 60px;
        height: 60px;
        background: var(--cma-navy);
        color: white;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
        font-size: 1.5rem;
    }

    /* Call to Action Buttons */
    .btn-cma {
        background: var(--cma-orange);
        color: white;
        font-weight: 700;
        padding: 15px 40px;
        border-radius: 50px;
        border: none;
        transition: 0.3s;
        text-transform: uppercase;
    }

        .btn-cma:hover {
            background: #d65a12;
            transform: scale(1.05);
            color: white;
        }

    .contact-badge {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        padding: 12px 25px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        margin-bottom: 10px;
        transition: 0.3s;
        cursor: pointer;
    }

        .contact-badge:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: translateX(10px);
        }
</style>

<div class="container-fluid p-0">
    <section class="hero-group1 text-center text-lg-start">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-7">
                    <span class="badge bg-light text-dark mb-3 px-3 py-2 rounded-pill fw-bold shadow-sm">
                        <i class="bi bi-journal-check text-orange"></i> CMA Intermediate - New Syllabus 2022
                    </span>
                    <h1 class="display-3 text-white fw-bold mb-3">CMA Intermediate <br /><span style="color: var(--cma-orange);">Group 1 Coaching</span></h1>
                    <p class="lead mb-4 opacity-75">Master the core pillars of Cost & Management Accountancy with Raipur's elite faculty. Comprehensive coaching for all 4 papers of Group 1.</p>

                    <div class="d-flex flex-wrap justify-content-center justify-content-lg-start gap-3">
                        <a href="https://wa.me/919926821000?text=Inquiry%20for%20CMA%20Inter%20Group%201" class="btn btn-cma">Inquire Now</a>
                        <a href="tel:07714095300" class="btn btn-outline-light rounded-pill px-4 fw-bold">Call Advisor</a>
                    </div>
                </div>
                <div class="col-lg-5 mt-5 mt-lg-0">
                    <div class="p-3">
                        <div class="contact-badge" onclick="location.href='tel:919926821000'">
                            <i class="bi bi-telephone-fill fs-3 me-3 text-warning"></i>
                            <div><h6 class="mb-0">Admissions</h6><small>99268-21000</small></div>
                        </div>
                        <div class="contact-badge" onclick="location.href='mailto:eeiraipur@gmail.com'">
                            <i class="bi bi-envelope-at-fill fs-3 me-3 text-warning"></i>
                            <div><h6 class="mb-0">Email Support</h6><small>eeiraipur@gmail.com</small></div>
                        </div>
                        <div class="contact-badge" onclick="window.open('https://www.exceledu.co.in')">
                            <i class="bi bi-geo-alt-fill fs-3 me-3 text-warning"></i>
                            <div><h6 class="mb-0">Visit Us</h6><small>Pachpedi Naka, Raipur</small></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <div class="container my-5 py-5">
        <div class="text-center mb-5">
            <h2 class="fw-bold display-5">Group 1 <span class="text-primary">Subject Mastery</span></h2>
            <p class="text-muted">Focused coaching for every paper to ensure 200+ marks in aggregate.</p>
        </div>

        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="subject-card">
                    <div class="icon-box"><i class="bi bi-bank"></i></div>
                    <h5 class="fw-bold">Law & Ethics</h5>
                    <p class="small text-muted">Business Laws, Corporate Laws, aur Industrial Laws ki deep understanding.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="subject-card">
                    <div class="icon-box"><i class="bi bi-calculator"></i></div>
                    <h5 class="fw-bold">Financial A/c</h5>
                    <p class="small text-muted">Conceptual clarity in Partnership, AS, aur Final Accounts.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="subject-card">
                    <div class="icon-box"><i class="bi bi-percent"></i></div>
                    <h5 class="fw-bold">Direct & Indirect Tax</h5>
                    <p class="small text-muted">GST aur Income Tax ke latest provisions aur practical problems.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="subject-card">
                    <div class="icon-box"><i class="bi bi-pie-chart"></i></div>
                    <h5 class="fw-bold">Cost Accounting</h5>
                    <p class="small text-muted">Costing basics, Material, Labour aur Overhead ka detailed analysis.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="container mb-5">
        <div class="p-5 rounded-5 bg-dark text-white text-center shadow-lg">
            <h2 class="fw-bold mb-4">Why Excel for Group 1?</h2>
            <div class="row g-4">
                <div class="col-md-4"><i class="bi bi-check-circle text-orange fs-1"></i><p class="mt-2">100% Syllabus Coverage</p></div>
                <div class="col-md-4"><i class="bi bi-check-circle text-orange fs-1"></i><p class="mt-2">Regular Mock Tests</p></div>
                <div class="col-md-4"><i class="bi bi-check-circle text-orange fs-1"></i><p class="mt-2">Doubt Clearing Hub</p></div>
            </div>
        </div>
    </div>
</div>