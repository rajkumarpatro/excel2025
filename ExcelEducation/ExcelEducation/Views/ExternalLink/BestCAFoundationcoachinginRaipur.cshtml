@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Best CA Foundation Coaching in Raipur | Excel Educational Institution";
    ViewData["Description"] = "Excel Educational Institution: The most trusted CA Foundation coaching in Raipur, Bhilai, and Chhattisgarh. Expert faculty, high pass rate, and result-oriented coaching.";
    ViewData["Keywords"] = "Best CA Foundation Coaching in Raipur, CA Foundation Coaching in Bhilai, CA Foundation Coaching in Durg, Best Commerce Coaching in Chhattisgarh";
}

<!-- Google Fonts & Icons -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --excel-blue: #1a237e;
        --excel-orange: #ff6d00;
        --glass-bg: rgba(255, 255, 255, 0.85);
        --glass-border: rgba(255, 255, 255, 0.5);
    }

    body {
        font-family: 'Poppins', sans-serif;
        background: linear-gradient(135deg, #f8f9ff 0%, #e9ecf5 100%);
        color: #2d3436;
    }

    /* Hero Section */
    .hero-excel {
        background: linear-gradient(rgba(26, 35, 126, 0.9), rgba(26, 35, 126, 0.9)), url('/images/campus-bg.jpg'); /* Background image path adjust karein */
        background-size: cover;
        background-position: center;
        padding: 80px 0;
        color: white;
        border-radius: 0 0 50px 50px;
        box-shadow: 0 15px 30px rgba(0,0,0,0.1);
    }

    .glass-card {
        background: var(--glass-bg);
        backdrop-filter: blur(10px);
        border: 1px solid var(--glass-border);
        border-radius: 20px;
        padding: 30px;
        transition: transform 0.3s ease;
        height: 100%;
        box-shadow: 0 8px 32px rgba(31, 38, 135, 0.07);
    }

        .glass-card:hover {
            transform: translateY(-10px);
            background: #fff;
        }

    .btn-action {
        background: var(--excel-orange);
        color: white;
        font-weight: 700;
        padding: 12px 30px;
        border-radius: 50px;
        text-transform: uppercase;
        border: none;
        transition: 0.3s;
    }

        .btn-action:hover {
            background: #e65100;
            color: white;
            transform: scale(1.05);
        }

    .course-badge {
        background: #e8eaf6;
        color: var(--excel-blue);
        padding: 5px 15px;
        border-radius: 10px;
        display: inline-block;
        margin: 5px;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .table-glass {
        background: white;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    }

        .table-glass thead {
            background: var(--excel-blue);
            color: white;
        }

    .section-title {
        font-weight: 700;
        color: var(--excel-blue);
        position: relative;
        margin-bottom: 40px;
    }

        .section-title::after {
            content: '';
            width: 80px;
            height: 5px;
            background: var(--excel-orange);
            position: absolute;
            bottom: -12px;
            left: 0;
        }
</style>

<div class="container-fluid p-0">
    <!-- Hero Section -->
    <section class="hero-excel text-center text-lg-start">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <h1 class="display-5 text-white fw-bold">Best CA Foundation Coaching in Raipur, Bhilai, Durg, Bilaspur & Chhattisgarh</h1>
                    <p class="lead mt-3 opacity-90">Welcome to <span class="fw-bold">Excel Educational Institution</span>, the most trusted name for professional Commerce education.</p>
                    <div class="mt-4">
                        <button class="btn btn-action me-2">Enroll Today</button>
                        <button class="btn btn-outline-light rounded-pill px-4">Download Brochure</button>
                    </div>
                </div>
                <div class="col-lg-4 mt-5 mt-lg-0">
                    <div class="glass-card text-dark">
                        <h5 class="fw-bold text-center mb-3">Successful Apply Now</h5>
                        <p class="small text-center">Join the new batch for May/Nov 2026</p>
                        <hr>
                        <div class="d-flex flex-wrap justify-content-center">
                            <span class="course-badge">CA Foundation</span>
                            <span class="course-badge">CS Executive</span>
                            <span class="course-badge">CMA Foundation</span>
                            <span class="course-badge">Class 11th/12th</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Main Content -->
    <div class="container my-5 py-4">
        <div class="row">
            <div class="col-lg-7">
                <h2 class="section-title">Looking for the <span class="text-primary">Best CA Foundation Coaching</span> in Raipur?</h2>
                <p>Welcome to <strong>Excel Educational Institution</strong>, Raipur, one of the <strong>trusted</strong> institutes for CA Foundation Coaching in Chhattisgarh. We provide <strong>expert</strong> professional coaching for students aiming for <strong>AIR Rankers</strong> status.</p>

                <h4 class="fw-bold mt-4">Why Excel is the Best Choice?</h4>
                <div class="row g-3 mt-2">
                    <div class="col-md-6">
                        <div class="p-3 border-start border-4 border-primary bg-white shadow-sm">
                            <h6 class="fw-bold">Expert Faculty</h6>
                            <p class="small mb-0 text-muted">Concept-based teaching by industry veterans.</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 border-start border-4 border-warning bg-white shadow-sm">
                            <h6 class="fw-bold">Smart Learning</h6>
                            <p class="small mb-0 text-muted">Performance Analysis & Weekly Mock Exams.</p>
                        </div>
                    </div>
                </div>

                <div class="mt-5">
                    <h4 class="fw-bold">Our Performance Metrics:</h4>
                    <ul class="list-unstyled">
                        <li><i class="bi bi-check2-circle text-success me-2"></i><strong>Highest Pass Rate</strong> in Chhattisgarh</li>
                        <li><i class="bi bi-check2-circle text-success me-2"></i><strong>Guaranteed</strong> Doubt Solving Sessions</li>
                        <li><i class="bi bi-check2-circle text-success me-2"></i><strong>Personalized</strong> Mentorship for every student</li>
                    </ul>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="glass-card border-0 shadow-sm" style="background: #fff;">
                    <h4 class="fw-bold mb-4">Quick Guidance</h4>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Talk to Counselor <span class="badge bg-primary rounded-pill"><i class="bi bi-telephone"></i></span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Book Free Demo <span class="badge bg-primary rounded-pill"><i class="bi bi-play"></i></span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Reserve Your Seat <span class="badge bg-primary rounded-pill"><i class="bi bi-bookmark"></i></span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Get Free Guidance <span class="badge bg-primary rounded-pill"><i class="bi bi-info-circle"></i></span>
                        </li>
                    </ul>
                    <button class="btn btn-primary w-100 mt-4 rounded-pill fw-bold">Start Preparation Now</button>
                </div>
            </div>
        </div>

        <!-- Courses Table -->
        <div class="row mt-5 pt-5">
            <div class="col-12">
                <h2 class="section-title text-center mx-auto" style="width: fit-content;">Courses Offered at Excel Institution</h2>
                <div class="table-responsive table-glass mt-4">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">Course Name</th>
                                <th class="text-center">Availability</th>
                                <th class="text-center">Mode</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var courses = new List<string> {
                                    "CA Foundation", "CA Intermediate", "CA Intermediate Group 1", "CA Intermediate Group 2",
                                    "CA Final", "CS EET", "CS Executive", "CS Executive Module 1", "CS Executive Module 2",
                                    "CMA Foundation", "CMA Intermediate", "Class XIth Coaching", "Class XIIth Coaching"
                                };
                                foreach (var course in courses)
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold">@course</td>
                                        <td class="text-center"><span class="text-success"><i class="bi bi-check-circle-fill"></i> Yes</span></td>
                                        <td class="text-center"><span class="badge bg-light text-dark border">Live/Offline</span></td>
                                    </tr>
                                }
                            }
                            <tr class="table-info">
                                <td class="ps-4 fw-bold">Live Online & Recorded Lectures</td>
                                <td class="text-center fw-bold">Yes</td>
                                <td class="text-center">Digital</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- SEO Footer Keywords Section -->
        <div class="row mt-5 py-5 bg-light rounded-4">
            <div class="col-12 text-center">
                <h5 class="fw-bold mb-4">Top Rated Coaching in Chhattisgarh</h5>
                <div class="d-flex flex-wrap justify-content-center gap-2">
                    <span class="btn btn-sm btn-outline-secondary rounded-pill">CA Foundation Raipur</span>
                    <span class="btn btn-sm btn-outline-secondary rounded-pill">CA Coaching Bhilai</span>
                    <span class="btn btn-sm btn-outline-secondary rounded-pill">Durg Commerce Classes</span>
                    <span class="btn btn-sm btn-outline-secondary rounded-pill">Bilaspur CA Institute</span>
                    <span class="btn btn-sm btn-outline-secondary rounded-pill">Best Accounts Coaching</span>
                    <span class="btn btn-sm btn-outline-secondary rounded-pill">Professional Coaching Near Me</span>
                </div>
            </div>
        </div>
    </div>
</div>