<!-- Custom Page Styles -->
<style>
    :root {
        --maroon-primary: #800000;
        --maroon-dark: #5c0000;
        --maroon-light: #fdf5f5;
        --accent-gold: #d4af37;
        --text-dark: #2c2c2c;
        --fe-maroon-dark: #3a0000;
        --fe-gold: #d4af37;
        --fe-gold-light: #ffd700;
        --fe-maroon-main: #800000;
    } 

    /* Glassmorphism Badge */
    .badge-glass {
        background: rgba(128, 0, 0, 0.08);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border: 1px solid rgba(128, 0, 0, 0.15);
        color: var(--maroon-primary);
        font-weight: 700;
        letter-spacing: 0.5px;
    } 
    .btn-maroon {
        background-color: var(--maroon-primary);
        color: #ffffff;
        border: 2px solid var(--maroon-primary);
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-maroon:hover {
            background-color: var(--maroon-dark);
            color: #ffffff;
            border-color: var(--maroon-dark);
        }

    .btn-outline-maroon {
        background-color: transparent;
        color: var(--maroon-primary);
        border: 2px solid var(--maroon-primary);
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-outline-maroon:hover {
            background-color: var(--maroon-primary);
            color: #ffffff;
        }
     
    /* Stats Card Glassmorphism Effect */
    .stat-box-modern {
        background: rgba(255, 255, 255, 0.9);
        border-radius: 16px;
        border: 1px solid rgba(128, 0, 0, 0.1);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .stat-box-modern:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(128, 0, 0, 0.12);
            border-color: var(--maroon-primary);
        }

    .stat-icon-wrapper {
        width: 50px;
        height: 50px;
        background-color: rgba(128, 0, 0, 0.08);
        color: var(--maroon-primary);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
    }
</style>
<!-- Custom CSS for Sections 6-8 -->
<style>
