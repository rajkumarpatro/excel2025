@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Best-CA-Foundation-Coaching-In-Raipur| Excel Educational Institution";
    ViewData["Description"] = "Excel Educational Institution: The most trusted CA Foundation coaching in Raipur, Bhilai, and Chhattisgarh. Expert faculty, high pass rate, and result-oriented coaching.";
    ViewData["Keywords"] = "Best CA Foundation Coaching in Raipur, CA Foundation Coaching in Bhilai, CA Foundation Coaching in Durg, Best Commerce Coaching in Chhattisgarh";
}
 
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Inter:wght@400;500;600;700&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
 
    <style>
    /* ─── ROOT TOKENS ─────────────────────────── */
    :root {
      --navy:     #0A1F44;
      --navy-mid: #112356;
      --gold:     #C9972A;
      --gold-lt:  #E8B84B;
      --cream:    #FDF8EE;
      --slate:    #4A5568;
      --white:    #FFFFFF;
      --light-bg: #F7F9FC;
      --border:   #E2E8F0;
      --radius-sm: 8px;
      --radius-md: 16px;
      --radius-lg: 24px;
      --shadow-sm: 0 2px 8px rgba(10,31,68,.07);
      --shadow-md: 0 8px 32px rgba(10,31,68,.12);
      --shadow-lg: 0 20px 60px rgba(10,31,68,.16);
      --font-display: 'Playfair Display', Georgia, serif;
      --font-body:    'Inter', sans-serif;
      --font-ui:      'DM Sans', sans-serif;
    }

    /* ─── BASE ────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body { font-family: var(--font-body); color: var(--slate); background: var(--white); overflow-x: hidden; }
    h1,h2,h3,h4,h5,h6 { font-family: var(--font-display); color: var(--navy); line-height: 1.25; }
    p { line-height: 1.75; }
    a { text-decoration: none; transition: all .2s; }
    img { max-width: 100%; height: auto; }

    /* ─── UTILITY ─────────────────────────────── */
    .text-gold { color: var(--gold) !important; }
    .bg-navy   { background: var(--navy) !important; }
    .bg-cream  { background: var(--cream) !important; }
    .bg-light-custom { background: var(--light-bg) !important; }
    .section-pad { padding: 80px 0; }
    .section-pad-sm { padding: 56px 0; }

    .eyebrow {
      display: inline-block;
      font-family: var(--font-ui);
      font-size: .75rem;
      font-weight: 600;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: var(--gold);
      background: rgba(201,151,42,.1);
      border: 1px solid rgba(201,151,42,.25);
      padding: 4px 14px;
      border-radius: 100px;
      margin-bottom: 14px;
    }

    .section-title {
        color:#751212;
      font-size: clamp(1.75rem, 4vw, 2.6rem);
      font-weight: 900;
      margin-bottom: .5rem;
    }
    .section-subtitle {
      font-size: 1.05rem;
      color: var(--slate);
      max-width: 640px;
      margin: 0 auto 40px;
    }

    .divider-gold {
      width: 60px; height: 4px;
      background: linear-gradient(90deg, var(--gold), var(--gold-lt));
      border-radius: 2px;
      margin: 12px auto 20px;
    }

    /* ─── NAVBAR ──────────────────────────────── */
    #mainNav {
      background: var(--white);
      box-shadow: var(--shadow-sm);
      padding: 12px 0;
      position: sticky;
      top: 0;
      z-index: 1050;
      transition: box-shadow .3s;
    }
    #mainNav .navbar-brand {
      font-family: var(--font-display);
      font-size: 1.4rem;
      font-weight: 900;
      color: var(--navy);
    }
    #mainNav .navbar-brand span { color: var(--gold); }
    .nav-link { font-family: var(--font-ui); font-weight: 500; color: var(--navy) !important; font-size: .9rem; padding: 6px 14px !important; }
    .nav-link:hover { color: var(--gold) !important; }
    .btn-nav-cta {
      background: var(--gold);
      color: var(--white) !important;
      border-radius: 100px;
      padding: 8px 22px !important;
      font-weight: 600;
    }
    .btn-nav-cta:hover { background: var(--navy); }

    /* ─── TOP BAR ─────────────────────────────── */
    .top-bar {
      background: var(--navy);
      color: rgba(255,255,255,.85);
      font-family: var(--font-ui);
      font-size: .8rem;
      padding: 6px 0;
    }
    .top-bar a { color: var(--gold-lt); }
    .top-bar a:hover { color: var(--white); }

    /* ─── HERO ────────────────────────────────── */
        .hero-section {
            background: linear-gradient(135deg, #800020 0%, #5C0B18 60%, #2B050B 100%);
            min-height: 92vh;
            display: flex;
            align-items: center;
            position: relative;
            overflow: hidden;
            padding: 80px 0 60px;
        }
    .hero-section::before {
      content: '';
      position: absolute;
      inset: 0;
      background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.025'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    }
    .hero-section::after {
      content: '';
      position: absolute;
      right: -120px;
      top: -120px;
      width: 600px;
      height: 600px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(201,151,42,.18) 0%, transparent 70%);
      pointer-events: none;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(201,151,42,.15);
      border: 1px solid rgba(201,151,42,.35);
      color: var(--gold-lt);
      font-family: var(--font-ui);
      font-size: .8rem;
      font-weight: 600;
      letter-spacing: .08em;
      text-transform: uppercase;
      padding: 6px 18px;
      border-radius: 100px;
      margin-bottom: 22px;
    }
    .hero-badge i { font-size: .7rem; }

    .hero-h1 {
      font-size: clamp(2.1rem, 5.5vw, 3.6rem);
      font-weight: 900;
      color: var(--white);
      line-height: 1.18;
      margin-bottom: 20px;
    }
    .hero-h1 .accent { color: var(--gold-lt); }

    .hero-lead {
      font-size: 1.05rem;
      color: rgba(255,255,255,.78);
      line-height: 1.8;
      margin-bottom: 28px; 
    }

    .hero-stats {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      margin-bottom: 36px;
    }
    .hero-stat {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }
    .hero-stat-number {
      font-family: var(--font-display);
      font-size: 1.9rem;
      font-weight: 900;
      color: var(--gold-lt);
      line-height: 1;
    }
    .hero-stat-label {
      font-family: var(--font-ui);
      font-size: .72rem;
      color: rgba(255,255,255,.65);
      text-transform: uppercase;
      letter-spacing: .06em;
      margin-top: 2px;
    }
    .hero-stat-divider { width: 1px; background: rgba(255,255,255,.15); }

    .hero-cta-group { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 32px; }

    .btn-hero-primary {
      background: linear-gradient(135deg, var(--gold) 0%, var(--gold-lt) 100%);
      color: var(--navy);
      font-family: var(--font-ui);
      font-weight: 700;
      font-size: .95rem;
      padding: 14px 28px;
      border-radius: 100px;
      border: none;
      box-shadow: 0 4px 20px rgba(201,151,42,.4);
      transition: all .25s;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .btn-hero-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 32px rgba(201,151,42,.5); color: var(--navy); }

    .btn-hero-secondary {
      background: rgba(255,255,255,.1);
      color: var(--white);
      font-family: var(--font-ui);
      font-weight: 600;
      font-size: .95rem;
      padding: 14px 28px;
      border-radius: 100px;
      border: 1px solid rgba(255,255,255,.25);
      backdrop-filter: blur(10px);
      transition: all .25s;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .btn-hero-secondary:hover { background: rgba(255,255,255,.2); color: var(--white); }

    .hero-trust-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 16px;
    }
    .hero-trust-item {
      display: flex;
      align-items: center;
      gap: 6px;
      font-family: var(--font-ui);
      font-size: .8rem;
      color: rgba(255,255,255,.7);
    }
    .hero-trust-item i { color: var(--gold-lt); font-size: .75rem; }

    /* Hero Image Card */
    .hero-image-card {
      background: rgba(255,255,255,.06);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(255,255,255,.12);
      border-radius: var(--radius-lg);
      padding: 28px;
      position: relative;
    }
    .hero-img-placeholder {
      width: 100%;
      aspect-ratio: 4/3;
      background: linear-gradient(135deg, rgba(255,255,255,.05), rgba(201,151,42,.08));
      border-radius: var(--radius-md);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      border: 2px dashed rgba(201,151,42,.3);
      color: rgba(255,255,255,.5);
      font-family: var(--font-ui);
      font-size: .85rem;
    }
    .hero-img-placeholder i { font-size: 3rem; color: rgba(201,151,42,.4); margin-bottom: 10px; }

    .hero-card-badge {
      position: absolute;
      top: -14px;
      right: 28px;
      background: var(--gold);
      color: var(--navy);
      font-family: var(--font-ui);
      font-size: .75rem;
      font-weight: 700;
      padding: 6px 18px;
      border-radius: 100px;
      white-space: nowrap;
    }

    .hero-mini-stats {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-top: 20px;
    }
    .hero-mini-stat {
      background: rgba(255,255,255,.06);
      border: 1px solid rgba(255,255,255,.08);
      border-radius: var(--radius-sm);
      padding: 14px;
      text-align: center;
    }
    .hero-mini-stat strong {
      display: block;
      font-family: var(--font-display);
      font-size: 1.5rem;
      font-weight: 900;
      color: var(--gold-lt);
    }
    .hero-mini-stat span {
      font-family: var(--font-ui);
      font-size: .72rem;
      color: rgba(255,255,255,.6);
    }

    /* ─── TRUST BAR ───────────────────────────── */
    .trust-bar {
      background: var(--cream);
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      padding: 16px 0;
    }
    .trust-item {
      display: flex;
      align-items: center;
      gap: 10px;
      font-family: var(--font-ui);
      font-size: .85rem;
      font-weight: 600;
      color: var(--navy);
    }
    .trust-item i { color: var(--gold); font-size: 1.1rem; }

    /* ─── STATS COUNTERS ──────────────────────── */
    .stat-card {
      background: var(--white);
      border-radius: var(--radius-md);
      padding: 36px 28px;
      text-align: center;
      box-shadow: var(--shadow-md);
      border-bottom: 4px solid var(--gold);
      transition: transform .3s;
    }
    .stat-card:hover { transform: translateY(-6px); }
    .stat-number {
      font-family: var(--font-display);
      font-size: 2.8rem;
      font-weight: 900;
      color: var(--navy);
      line-height: 1;
    }
    .stat-number .plus { color: var(--gold); }
    .stat-label { font-family: var(--font-ui); font-size: .85rem; color: var(--slate); margin-top: 6px; font-weight: 500; }
    .stat-icon { font-size: 2rem; color: var(--gold); margin-bottom: 14px; }

    /* ─── WHY CHOOSE CARDS ────────────────────── */
    .feature-card {
      background: var(--white);
      border-radius: var(--radius-md);
      padding: 32px 24px;
      box-shadow: var(--shadow-sm);
      border: 1px solid var(--border);
      transition: all .3s;
      height: 100%;
    }
    .feature-card:hover { box-shadow: var(--shadow-md); transform: translateY(-4px); border-color: var(--gold); }
    .feature-icon {
      width: 56px; height: 56px;
      background: linear-gradient(135deg, rgba(201,151,42,.12), rgba(201,151,42,.05));
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.4rem;
      color: var(--gold);
      margin-bottom: 18px;
    }
    .feature-card h4 { font-size: 1.05rem; margin-bottom: 10px; }
    .feature-card p { font-size: .88rem; margin: 0; }

    /* ─── FACULTY CARDS ───────────────────────── */
    .faculty-card {
      background: var(--white);
      border-radius: var(--radius-md);
      overflow: hidden;
      box-shadow: var(--shadow-sm);
      border: 1px solid var(--border);
      transition: all .3s;
    }
    .faculty-card:hover { box-shadow: var(--shadow-md); transform: translateY(-4px); }
    .faculty-img {
      width: 100%;
      aspect-ratio: 1;
      background: linear-gradient(135deg, var(--light-bg), var(--cream));
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      color: var(--slate);
      font-size: .8rem;
      border-bottom: 3px solid var(--gold);
    }
    .faculty-img i { font-size: 3.5rem; color: rgba(10,31,68,.25); margin-bottom: 8px; }
    .faculty-body { padding: 20px; }
    .faculty-name { font-size: 1.05rem; font-weight: 700; margin-bottom: 4px; }
    .faculty-role { font-family: var(--font-ui); font-size: .8rem; color: var(--gold); font-weight: 600; text-transform: uppercase; letter-spacing: .06em; }
    .faculty-qual { font-size: .85rem; color: var(--slate); margin: 10px 0 0; }
    .faculty-tag {
      display: inline-block;
      background: rgba(10,31,68,.06);
      border-radius: 100px;
      padding: 3px 12px;
      font-size: .75rem;
      font-family: var(--font-ui);
      color: var(--navy);
      margin: 4px 2px 0;
    }

    /* ─── TESTIMONIAL CARDS ───────────────────── */
    .testimonial-card {
      background: var(--white);
      border-radius: var(--radius-md);
      padding: 28px;
      box-shadow: var(--shadow-sm);
      border: 1px solid var(--border);
      height: 100%;
      position: relative;
    }
    .testimonial-card::before {
      content: '\201C';
      font-family: var(--font-display);
      font-size: 4rem;
      color: var(--gold);
      opacity: .2;
      position: absolute;
      top: 10px; left: 20px;
      line-height: 1;
    }
    .testimonial-stars { color: #F59E0B; font-size: .85rem; margin-bottom: 12px; }
    .testimonial-text { font-size: .9rem; line-height: 1.75; color: var(--slate); margin-bottom: 18px; }
    .testimonial-author { display: flex; align-items: center; gap: 12px; }
    .author-avatar {
      width: 46px; height: 46px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--navy), var(--navy-mid));
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-display);
      font-size: 1.1rem;
      color: var(--gold-lt);
      font-weight: 900;
      flex-shrink: 0;
    }
    .author-name { font-weight: 700; font-size: .9rem; color: var(--navy); }
    .author-detail { font-size: .78rem; color: var(--slate); font-family: var(--font-ui); }

    /* ─── ACCORDION FAQ ───────────────────────── */
    .faq-accordion .accordion-item {
      border: 1px solid var(--border);
      border-radius: var(--radius-sm) !important;
      margin-bottom: 10px;
      overflow: hidden;
    }
    .faq-accordion .accordion-button {
      font-family: var(--font-display);
      font-size: 1rem;
      color: var(--navy);
      font-weight: 700;
      background: var(--white);
      box-shadow: none;
      padding: 18px 22px;
    }
    .faq-accordion .accordion-button:not(.collapsed) {
      background: linear-gradient(135deg, rgba(10,31,68,.03), rgba(201,151,42,.05));
      color: var(--navy);
    }
    .faq-accordion .accordion-button::after { filter: none; }
    .faq-accordion .accordion-body {
      font-size: .92rem;
      line-height: 1.8;
      color: var(--slate);
      padding: 0 22px 20px;
    }

    /* ─── COMPARISON TABLE ────────────────────── */
    .comparison-table { border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-md); }
    .comparison-table thead { background: var(--navy); color: var(--white); }
    .comparison-table thead th { padding: 18px 22px; font-family: var(--font-ui); font-weight: 600; }
    .comparison-table thead .excel-col { background: var(--gold); color: var(--navy); }
    .comparison-table tbody tr:nth-child(even) { background: var(--light-bg); }
    .comparison-table tbody td { padding: 14px 22px; font-size: .9rem; vertical-align: middle; }
    .comparison-table .feature-name { font-weight: 600; color: var(--navy); }
    .check-yes { color: #059669; font-size: 1.1rem; }
    .check-no  { color: #DC2626; font-size: 1.1rem; }

    /* ─── GALLERY ─────────────────────────────── */
    .gallery-item {
      aspect-ratio: 4/3;
      border-radius: var(--radius-md);
      background: linear-gradient(135deg, var(--light-bg), var(--cream));
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      color: var(--slate);
      font-size: .82rem;
      font-family: var(--font-ui);
      border: 1px solid var(--border);
      overflow: hidden;
      position: relative;
      cursor: pointer;
      transition: all .3s;
    }
    .gallery-item:hover { box-shadow: var(--shadow-md); transform: scale(1.02); }
    .gallery-item i { font-size: 2.5rem; color: rgba(10,31,68,.2); margin-bottom: 10px; }
    .gallery-label {
      position: absolute;
      bottom: 0; left: 0; right: 0;
      background: linear-gradient(transparent, rgba(10,31,68,.75));
      color: var(--white);
      padding: 20px 16px 14px;
      font-weight: 600;
    }

    /* ─── PROCESS STEPS ───────────────────────── */
    .process-step {
      display: flex;
      gap: 20px;
      margin-bottom: 32px;
    }
    .step-num {
      width: 50px;
      height: 50px;
      flex-shrink: 0;
      border-radius: 50%;
      background: var(--navy);
      color: var(--gold-lt);
      font-family: var(--font-display);
      font-size: 1.2rem;
      font-weight: 900;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .step-content h5 { font-size: 1rem; margin-bottom: 6px; }
    .step-content p { font-size: .88rem; margin: 0; }

    /* ─── FEE TABLE ───────────────────────────── */
    .fee-card {
      background: var(--white);
      border-radius: var(--radius-md);
      padding: 32px;
      box-shadow: var(--shadow-md);
      border-top: 4px solid var(--gold);
      text-align: center;
      transition: transform .3s;
    }
    .fee-card:hover { transform: translateY(-4px); }
    .fee-card.featured { border-top-color: var(--navy); background: var(--navy); color: var(--white); }
    .fee-card.featured h4, .fee-card.featured p { color: rgba(255,255,255,.85); }
    .fee-card.featured .badge-popular { background: var(--gold); color: var(--navy); }
    .fee-price { font-family: var(--font-display); font-size: 2.4rem; font-weight: 900; color: var(--navy); }
    .fee-card.featured .fee-price { color: var(--gold-lt); }
    .fee-list { list-style: none; padding: 0; text-align: left; }
    .fee-list li { padding: 6px 0; font-size: .88rem; display: flex; align-items: center; gap: 8px; }
    .fee-list li i { color: var(--gold); }
    .fee-card.featured .fee-list li i { color: var(--gold-lt); }

    /* ─── NEARBY CITIES ───────────────────────── */
    .city-chip {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: 100px;
      padding: 8px 18px;
      font-family: var(--font-ui);
      font-size: .85rem;
      font-weight: 500;
      color: var(--navy);
      transition: all .2s;
      cursor: pointer;
    }
    .city-chip:hover { background: var(--navy); color: var(--white); border-color: var(--navy); }
    .city-chip i { font-size: .8rem; color: var(--gold); }

    /* ─── CTA SECTION ─────────────────────────── */
        .cta-section {
            background: linear-gradient(135deg, #7B1113, #5A0F10, #3A0708);
            position: relative;
            overflow: hidden;
        }
    .cta-section::after {
      content: '';
      position: absolute;
      right: -80px; bottom: -80px;
      width: 380px; height: 380px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(201,151,42,.18) 0%, transparent 70%);
    }

    /* ─── GOOGLE REVIEW CARDS ─────────────────── */
    .g-review-card {
      background: var(--white);
      border-radius: var(--radius-md);
      padding: 24px;
      box-shadow: var(--shadow-sm);
      border: 1px solid var(--border);
    }
    .g-logo { font-size: 1.4rem; font-weight: 900; margin-bottom: 12px; }
