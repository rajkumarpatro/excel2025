<style>
    :root {
        --bilaspur-maroon: #700000; /* CS Professional Identity */
        --bilaspur-gold: #c5a059;
        --glass-bg: rgba(255, 255, 255, 0.7);
        --glass-border: rgba(255, 255, 255, 0.3);
    }

    body {
        font-family: 'Poppins', sans-serif;
        background-color: #f8f9fa;
        color: #333;
    }

    /* Animated Hero Section */
    .hero-bilaspur {
        background: linear-gradient(135deg, var(--bilaspur-maroon) 0%, #300000 100%);
        padding: 110px 0;
        color: white;
        border-radius: 0 0 100px 0;
        position: relative;
        overflow: hidden;
    }

        .hero-bilaspur::before {
            content: "";
            position: absolute;
            top: -20%;
            right: -10%;
            width: 60%;
            height: 140%;
            background: radial-gradient(circle, rgba(197, 160, 89, 0.2) 0%, transparent 60%);
            animation: glow-move 10s infinite alternate;
        }

    @@keyframes glow-move {
        from {
            transform: translate(0, 0);
        }

        to {
            transform: translate(-20px, 20px);
        }
    }

    /* Glassmorphism Feature Cards */
    .glass-card-jbp {
        background: var(--glass-bg);
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        border: 1px solid var(--glass-border);
        border-radius: 30px;
        padding: 40px;
        transition: all 0.4s ease;
        height: 100%;
        box-shadow: 0 15px 35px rgba(0,0,0,0.05);
    }

        .glass-card-jbp:hover {
            transform: translateY(-15px);
            background: #ffffff;
            box-shadow: 0 25px 50px rgba(112, 0, 0, 0.1);
            border-color: var(--bilaspur-gold);
        }

    .icon-box-cs {
        width: 70px;
        height: 70px;
        background: var(--bilaspur-maroon);
        color: white;
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 25px;
        font-size: 1.8rem;
        transition: 0.5s;
    }

    .glass-card-jbp:hover .icon-box-cs {
        background: var(--bilaspur-gold);
        transform: rotateY(360deg);
    }

    /* Contact Bubbles */
    .contact-item-blp {
        background: rgba(255, 255, 255, 0.1);
        padding: 15px 25px;
        border-radius: 15px;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        border: 1px solid rgba(255, 255, 255, 0.2);
        transition: 0.3s;
        cursor: pointer;
    }

        .contact-item-blp:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: translateX(10px);
        }

    .btn-bilaspur {
        background: var(--bilaspur-gold);
        color: white;
        font-weight: 700;
        padding: 15px 40px;
        border-radius: 50px;
        text-transform: uppercase;
        border: none;
        transition: 0.3s;
    }

        .btn-bilaspur:hover {
            background: #b38b4d;
            box-shadow: 0 10px 20px rgba(197, 160, 89, 0.4);
            transform: translateY(-3px);
            color: white;
        }
</style>

