<style>
    :root {
        --india-primary: #0f172a; /* Deep Space Blue */
        --india-accent: #38bdf8; /* Cyan/Sky Blue */
        --glass-bg: rgba(255, 255, 255, 0.05);
        --glass-border: rgba(255, 255, 255, 0.1);
    }

    body {
        font-family: 'Poppins', sans-serif;
        background-color: #020617; /* Very Dark Background */
        color: #f8fafc;
    }

    /* Ultra-Modern National Hero Section */
    .hero-national {
        background: radial-gradient(circle at top right, #1e293b 0%, #020617 100%);
        padding: 120px 0;
        position: relative;
        overflow: hidden;
        border-bottom: 1px solid var(--glass-border);
    }

        .hero-national::before {
            content: "";
            position: absolute;
            width: 400px;
            height: 400px;
            background: var(--india-accent);
            filter: blur(150px);
            opacity: 0.15;
            top: -100px;
            left: -100px;
        }

    /* Glassmorphism Product Cards */
    .glass-course-card {
        background: var(--glass-bg);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid var(--glass-border);
        border-radius: 24px;
        padding: 30px;
        transition: all 0.4s ease;
        text-align: center;
    }

        .glass-course-card:hover {
            transform: translateY(-10px) scale(1.02);
            background: rgba(255, 255, 255, 0.1);
            border-color: var(--india-accent);
            box-shadow: 0 20px 40px rgba(0,0,0,0.4);
        }

    /* Buttons with Glow */
    .btn-glow {
        background: var(--india-accent);
        color: #020617;
        font-weight: 700;
        padding: 14px 35px;
        border-radius: 12px;
        border: none;
        box-shadow: 0 0 20px rgba(56, 189, 248, 0.3);
        transition: 0.3s;
    }

        .btn-glow:hover {
            background: #7dd3fc;
            box-shadow: 0 0 30px rgba(56, 189, 248, 0.6);
            color: #020617;
            transform: translateY(-2px);
        }

    .stat-box {
        border-left: 2px solid var(--india-accent);
        padding-left: 20px;
        margin-bottom: 20px;
    }
</style>

