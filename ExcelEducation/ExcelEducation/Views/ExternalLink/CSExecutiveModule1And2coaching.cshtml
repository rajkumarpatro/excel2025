@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Best CS Executive Module 1 & 2 Coaching | Top CS Institute";
    ViewData["Description"] = "Master both modules of CS Executive with India's leading mentors. Expert coaching for Law, Taxation, and Accounts with a focus on ICSI New Syllabus.";
    ViewData["Keywords"] = "CS Executive Both Modules coaching, CS Executive classes Module 1 and 2, Best CS coaching India, CS Executive full course, Excel Education CS";
}

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --cs-maroon: #5a0001;
        --cs-gold: #d4af37;
        --glass-bg: rgba(255, 255, 255, 0.95);
        --glass-border: rgba(255, 255, 255, 0.2);
    }

    body {
        font-family: 'Poppins', sans-serif;
        background-color: #fdfdfd;
        color: #222;
    }

    /* Professional Executive Hero Section */
    .hero-cs-executive {
        background: linear-gradient(135deg, var(--cs-maroon) 0%, #2a0001 100%);
        padding: 120px 0;
        color: white;
        border-radius: 0 0 120px 0;
        position: relative;
        overflow: hidden;
    }

        .hero-cs-executive::before {
            content: "";
            position: absolute;
            top: -10%;
            right: -10%;
            width: 100%;
            height: 120%;
            background: radial-gradient(circle, rgba(212, 175, 55, 0.1) 0%, transparent 60%);
            animation: rotate-slow 20s linear infinite;
        }

    @@keyframes rotate-slow {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    /* Glassmorphism Module Cards */
    .glass-card-cs {
        background: var(--glass-bg);
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        border: 1px solid var(--glass-border);
        border-radius: 35px;
        padding: 40px;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        height: 100%;
        box-shadow: 0 15px 35px rgba(90, 0, 1, 0.05);
    }

        .glass-card-cs:hover {
            transform: translateY(-15px);
            background: #ffffff;
            box-shadow: 0 25px 50px rgba(90, 0, 1, 0.12);
            border-color: var(--cs-gold);
        }

    .icon-badge {
        width: 75px;
        height: 75px;
        background: var(--cs-maroon);
        color: white;
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 25px;
        font-size: 2rem;
        box-shadow: 0 10px 20px rgba(90, 0, 1, 0.2);
    }

    /* Action Buttons */
    .btn-executive {
        background: var(--cs-gold);
        color: #000;
        font-weight: 700;
        padding: 16px 45px;
        border-radius: 50px;
        text-transform: uppercase;
        border: none;
        transition: 0.3s;
        letter-spacing: 1px;
    }

        .btn-executive:hover {
            background: #b38b2d;
            box-shadow: 0 12px 25px rgba(212, 175, 89, 0.4);
            transform: scale(1.05);
            color: #fff;
        }

    .contact-bubble-cs {
        background: rgba(255, 255, 255, 0.1);
        padding: 18px 25px;
        border-radius: 20px;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        border: 1px solid rgba(255, 255, 255, 0.2);
        transition: 0.3s;
        cursor: pointer;
    }

        .contact-bubble-cs:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: translateX(10px);
            border-color: var(--cs-gold);
        }
</style>

