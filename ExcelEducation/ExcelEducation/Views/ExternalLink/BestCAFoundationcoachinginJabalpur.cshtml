<style>
    :root {
        --jbp-blue: #002b5b; /* Deep Professional Blue */
        --jbp-gold: #e1b12c; /* Marble City Gold Accent */
        --glass-bg: rgba(255, 255, 255, 0.1);
        --glass-border: rgba(255, 255, 255, 0.2);
    }

    body {
        font-family: 'Poppins', sans-serif;
        background-color: #f1f2f6;
        color: #2f3542;
    }

    /* Animated Hero Section */
    .hero-jabalpur {
        background: linear-gradient(135deg, var(--jbp-blue) 0%, #001a33 100%);
        padding: 100px 0;
        color: white;
        border-radius: 0 0 100px 0;
        position: relative;
        overflow: hidden;
    }

        .hero-jabalpur::before {
            content: "";
            position: absolute;
            top: -50%;
            left: -10%;
            width: 100%;
            height: 200%;
            background: radial-gradient(circle, rgba(225, 177, 44, 0.1) 0%, transparent 60%);
            animation: rotate-bg 25s linear infinite;
        }

    @@keyframes rotate-bg {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    /* Glassmorphism Feature Cards */
    .glass-card-jbp {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        border: 1px solid var(--glass-border);
        border-radius: 30px;
        padding: 40px;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        height: 100%;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    }

        .glass-card-jbp:hover {
            transform: translateY(-15px);
            background: #ffffff;
            box-shadow: 0 25px 50px rgba(0, 43, 91, 0.1);
            border-color: var(--jbp-gold);
        }

    .icon-circle-jbp {
        width: 70px;
        height: 70px;
        background: var(--jbp-blue);
        color: white;
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 25px;
        font-size: 1.8rem;
        transition: 0.5s;
    }

    .glass-card-jbp:hover .icon-circle-jbp {
        background: var(--jbp-gold);
        transform: scale(1.1) rotate(10deg);
    }

    /* Action Buttons */
    .btn-jbp {
        background: var(--jbp-gold);
        color: #000;
        font-weight: 700;
        padding: 15px 40px;
        border-radius: 50px;
        text-transform: uppercase;
        border: none;
        transition: 0.3s;
        letter-spacing: 1px;
    }

        .btn-jbp:hover {
            background: #c99c1f;
            box-shadow: 0 10px 20px rgba(225, 177, 44, 0.4);
            transform: translateY(-3px);
            color: #000;
        }

    .quick-link-jbp {
        background: #f8f9fa;
        border-radius: 15px;
        padding: 15px 25px;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        text-decoration: none;
        color: var(--jbp-blue);
        font-weight: 600;
        transition: 0.3s;
    }

        .quick-link-jbp:hover {
            background: var(--jbp-blue);
            color: white;
            transform: translateX(10px);
        }
</style>

