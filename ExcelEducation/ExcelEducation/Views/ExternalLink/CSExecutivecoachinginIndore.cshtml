<style>
    :root {
        --cma-orange: #f37021; /* ICMAI Brand Color */
        --cma-navy: #002b5b;
        --glass-bg: rgba(255, 255, 255, 0.85);
        --glass-border: rgba(255, 255, 255, 0.4);
    }

    body {
        font-family: 'Poppins', sans-serif;
        background-color: #f0f2f5;
        color: #333;
    }

    /* Professional Hero Section */
    .hero-cma {
        background: linear-gradient(135deg, var(--cma-navy) 0%, #001a33 100%);
        padding: 100px 0;
        color: white;
        border-radius: 0 0 120px 0;
        position: relative;
        overflow: hidden;
    }

        .hero-cma::before {
            content: "";
            position: absolute;
            top: -50px;
            right: -50px;
            width: 300px;
            height: 300px;
            background: rgba(243, 112, 33, 0.2);
            border-radius: 50%;
            filter: blur(80px);
        }

    /* Structured Glass Cards */
    .glass-feature {
        background: var(--glass-bg);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid var(--glass-border);
        border-radius: 25px;
        padding: 35px;
        transition: all 0.4s ease;
        height: 100%;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    }

        .glass-feature:hover {
            transform: translateY(-12px);
            background: #ffffff;
            border-color: var(--cma-orange);
            box-shadow: 0 20px 40px rgba(243, 112, 33, 0.1);
        }

    .icon-circle {
        width: 65px;
        height: 65px;
        background: var(--cma-orange);
        color: white;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
        font-size: 1.6rem;
    }

    /* Action Buttons */
    .btn-cma {
        background: var(--cma-orange);
        color: white;
        font-weight: 700;
        padding: 15px 40px;
        border-radius: 50px;
        text-transform: uppercase;
        border: none;
        transition: 0.3s;
    }

        .btn-cma:hover {
            background: #d65a12;
            box-shadow: 0 10px 20px rgba(243, 112, 33, 0.4);
            transform: scale(1.05);
            color: white;
        }

    .contact-card {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        padding: 20px;
        border-radius: 20px;
        margin-bottom: 15px;
        transition: 0.3s;
        cursor: pointer;
    }

        .contact-card:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: translateX(10px);
        }
</style>

