        color: var(--blp-accent);
        margin-bottom: 20px;
        display: inline-block;
        text-shadow: 0 0 20px rgba(197, 160, 89, 0.4);
    }

    /* Buttons */
    .btn-gold {
        background: var(--blp-accent);
        color: #020617;
        font-weight: 700;
        padding: 15px 40px;
        border-radius: 12px;
        border: none;
