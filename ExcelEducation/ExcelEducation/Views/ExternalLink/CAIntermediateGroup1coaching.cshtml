                    </ul>
                </div>
            </div>

            <!-- Subject 2 -->
            <div class="col-md-4 mb-4">
                <div class="glass-card shadow-sm">
                    <div class="subject-icon">⚖️</div>
                    <h4 class="fw-bold">Corporate & Laws</h4>
                    <p class="text-muted"><span class="highlight-text">Interactive</span> classes complex provisions ko samjhne ke liye.</p>
                    <ul class="list-unstyled text-start">
                        <li>✅ <span class="fw-bold">Expert</span> Case Study Analysis</li>
