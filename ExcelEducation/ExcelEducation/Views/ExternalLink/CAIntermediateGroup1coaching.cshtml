<!-- Custom Maroon Theme Styles -->
<style>
    :root {
        --maroon-primary: #800000;
        --maroon-dark: #5c0000;
        --maroon-light: #fdf5f5;
        --accent-gold: #d4af37;
        --text-dark: #2c2c2c;
    }

    .bg-maroon {
        background-color: var(--maroon-primary) !important;
    }

    .text-maroon {
        color: var(--maroon-primary) !important;
    }

    .btn-maroon {
        background-color: var(--maroon-primary);
        color: #ffffff;
        border: 2px solid var(--maroon-primary);
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-maroon:hover {
            background-color: var(--maroon-dark);
            color: #ffffff;
            border-color: var(--maroon-dark);
        }

    .btn-outline-maroon {
        background-color: transparent;
        color: var(--maroon-primary);
        border: 2px solid var(--maroon-primary);
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-outline-maroon:hover {
            background-color: var(--maroon-primary);
            color: #ffffff;
        }

    /* Hero Section */
    .hero-section {
        background: linear-gradient(135deg, #ffffff 0%, var(--maroon-light) 100%);
        border-bottom: 3px solid var(--maroon-primary);
    }

    .eyebrow-badge {
        background-color: rgba(128, 0, 0, 0.1);
        color: var(--maroon-primary);
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        font-size: 0.85rem;
    }

    /* Stat Bar */
    .stat-bar {
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        border-radius: 12px;
        background: #ffffff;
    }

    .stat-card {
        border-right: 1px solid #eeeeee;
    }

        .stat-card:last-child {
            border-right: none;
        }

    /* Feature Cards */
    .feature-card {
        border: 1px solid #eaeaea;
        border-radius: 10px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        background: #ffffff;
    }

        .feature-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 25px rgba(128, 0, 0, 0.12);
            border-color: var(--maroon-primary);
        }

    .feature-icon {
        width: 48px;
        height: 48px;
        background-color: var(--maroon-light);
        color: var(--maroon-primary);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        font-weight: bold;
    }
</style>

<!-- Maroon Theme CSS Extensions -->
<style>
    .bg-maroon-soft {
        background-color: rgba(128, 0, 0, 0.04);
    }

    .border-maroon-light {
        border-color: rgba(128, 0, 0, 0.15) !important;
    }

    /* Accordion Custom Styling */
    .accordion-button:not(.collapsed) {
        color: #ffffff;
        background-color: var(--maroon-primary);
        box-shadow: none;
    }

        .accordion-button:not(.collapsed)::after {
            filter: brightness(0) invert(1);
        }

    .accordion-button:focus {
        box-shadow: none;
        border-color: rgba(128, 0, 0, 0.25);
    }

    /* Step Timeline Styling */
    .timeline-step {
        position: relative;
        padding-left: 2.5rem;
    }

        .timeline-step::before {
            content: '';
            position: absolute;
            left: 0.85rem;
            top: 2.2rem;
            bottom: -1rem;
            width: 2px;
            background-color: rgba(128, 0, 0, 0.2);
        }

        .timeline-step:last-child::before {
            display: none;
        }

    .step-number {
        position: absolute;
        left: 0;
        top: 0;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background-color: var(--maroon-primary);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.95rem;
    }

    /* Result Ledger Box */
    .ledger-card {
        background: #ffffff;
        border: 2px dashed var(--maroon-primary);
        border-radius: 12px;
        position: relative;
    }

    .stamp-badge {
        background: var(--maroon-primary);
        color: #ffffff;
        padding: 6px 16px;
        border-radius: 20px;
        font-weight: 700;
        font-size: 0.85rem;
        display: inline-block;
        box-shadow: 0 4px 10px rgba(128,0,0,0.25);
    }
</style>

<!-- Custom Styles for Sections 11-14 -->
<style>
