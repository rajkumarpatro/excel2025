@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Best CA Intermediate Group 1 Coaching in Raipur | Top CA Inter Classes";
    ViewData["Description"] = "Join the best CA Intermediate Group 1 coaching in Raipur with expert faculty, mock tests, mentorship, and highest pass rate. Result-oriented classes for May/Nov 2026.";
    ViewData["Keywords"] = "CA Intermediate Group 1 coaching, CA Inter Group 1 classes in Raipur, Best CA Inter coaching, CA coaching institute, Expert CA Inter classes, Trusted CA coaching";
}

<!-- Google Fonts & Bootstrap Icons -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --primary-color: #2575fc;
        --secondary-color: #6a11cb;
        --accent-color: #ff9800;
        --glass-bg: rgba(255, 255, 255, 0.1);
        --glass-border: rgba(255, 255, 255, 0.2);
    }

    body {
        font-family: 'Poppins', sans-serif;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        color: #333;
    }

    /* Hero Section with Glassmorphism */
    .hero-section {
        background: linear-gradient(to right, var(--secondary-color), var(--primary-color));
        padding: 60px 0;
        color: white;
        border-radius: 0 0 50px 50px;
        margin-bottom: 50px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }

    .badge-premium {
        background: var(--accent-color);
        color: #fff;
        padding: 5px 15px;
        border-radius: 20px;
        font-size: 0.9rem;
        text-transform: uppercase;
        font-weight: 700;
        margin-bottom: 15px;
        display: inline-block;
    }

    .glass-card {
        background: white;
        border: 1px solid var(--glass-border);
        border-radius: 20px;
        padding: 30px;
        transition: transform 0.3s ease;
        height: 100%;
        position: relative;
        overflow: hidden;
    }

        .glass-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.1);
        }

    .subject-icon {
        font-size: 2.5rem;
        margin-bottom: 20px;
        display: block;
    }

    .btn-enroll {
        background: #fff;
        color: var(--primary-color);
        font-weight: 700;
        border-radius: 30px;
        padding: 15px 40px;
        border: none;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

        .btn-enroll:hover {
            background: #f8f9fa;
            color: var(--secondary-color);
            transform: scale(1.05);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

    .section-title {
        font-weight: 700;
        margin-bottom: 40px;
        position: relative;
    }

        .section-title::after {
            content: '';
            width: 60px;
            height: 4px;
            background: var(--primary-color);
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
        }

    .highlight-text {
        color: var(--primary-color);
        font-weight: 600;
    }
</style>

<div class="container-fluid p-0">
    <!-- Hero Section -->
    <section class="hero-section text-center">
        <div class="container">
            <span class="badge-premium">Premium Learning Experience</span>
            <h1 class="display-4 text-white fw-bold mb-3">Best CA Intermediate Group 1 Coaching</h1>
            <p class="lead mb-4">India’s <span class="fw-bold">Top</span> Expert Faculty for <span class="fw-bold text-warning">AIR Rankers</span>. May/Nov 2026 Attempt ke liye <span class="fw-bold">Proven</span> Structured Preparation.</p>

            <div class="d-flex flex-wrap justify-content-center gap-3">
                <button class="btn btn-enroll shadow" onclick="location.href='#enroll'">Enroll Today</button>
                <button class="btn btn-outline-light rounded-pill px-4" onclick="location.href='#demo'">Book Free Demo</button>
            </div>

            <div class="mt-4">
                <span class="me-3"><i class="bi bi-check-circle-fill"></i> Highest Pass Rate</span>
                <span><i class="bi bi-check-circle-fill"></i> Guaranteed Syllabus Completion</span>
            </div>
        </div>
    </section>

    <div class="container mb-5">
        <div class="row text-center mb-5">
