@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "CA-Intermediate-Group-1-Coaching";
    ViewData["Description"] = "Join the best CA Intermediate Group 1 coaching in Raipur with expert faculty, mock tests, mentorship, and highest pass rate. Result-oriented classes for May/Nov 2026.";
    ViewData["Keywords"] = "CA Intermediate Group 1 coaching, CA Inter Group 1 classes in Raipur, Best CA Inter coaching, CA coaching institute, Expert CA Inter classes, Trusted CA coaching";
}

<!-- Google Fonts & Icons -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">


<style>
    :root {
        --navy: #3B0A0F;
        --navy-deep: #220508;
        --gold: #C1272D;
        --gold-light: #E84C4C;
        --ivory: #F2F1EF;
        --white: #FFFFFF;
        --green: #7A1F23;
        --slate: #5A5A5A;
        --ink: #1A1A1A;
        --line: #DEDCD8;
        --radius: 18px;
        --radius-sm: 10px;
        --shadow: 0 20px 50px -20px rgba(20,5,7,0.3);
        --shadow-sm: 0 8px 24px -12px rgba(20,5,7,0.2);
    }

    * {
        box-sizing: border-box;
    }

    html {
        scroll-behavior: smooth;
    }

    body {
        margin: 0;
        font-family: 'Inter',system-ui,sans-serif;
        color: var(--ink);
        background: var(--white);
        -webkit-font-smoothing: antialiased;
        line-height: 1.6;
    }

    h1, h2, h3 {
        font-family: 'Fraunces',serif;
        margin: 0;
        color: var(--navy);
        line-height: 1.12;
    }

    p {
        margin: 0;
    }

    img {
        max-width: 100%;
        display: block;
    }

    a {
        text-decoration: none;
        color: inherit;
    }

    .mono {
        font-family: 'IBM Plex Mono',monospace;
    }



    section {
        padding: 88px 0;
    }

    .eyebrow {
        font-family: 'IBM Plex Mono',monospace;
        font-size: 13px;
        letter-spacing: .14em;
        text-transform: uppercase;
        color: var(--gold);
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 16px;
    }

        .eyebrow::before {
            content: '';
            width: 22px;
            height: 2px;
            background: var(--gold);
            display: inline-block;
        }

    .lead {
        color: var(--slate);
        font-size: 17px;
        max-width: 680px;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 15px 28px;
        border-radius: 999px;
        font-weight: 700;
        font-size: 15.5px;
        cursor: pointer;
        border: none;
        transition: transform .15s ease, box-shadow .15s ease;
        font-family: 'Inter',sans-serif;
    }

        .btn:hover {
            transform: translateY(-2px);
        }

    .btn-gold {
        background: linear-gradient(135deg,var(--gold-light),var(--gold));
        color: var(--navy-deep);
        box-shadow: 0 12px 30px -10px rgba(201,162,39,0.55);
    }

    .btn-outline {
        background: transparent;
        border: 1.5px solid rgba(255,255,255,0.45);
        color: var(--white);
    }

        .btn-outline:hover {
            background: rgba(255,255,255,0.08);
        }

    .btn-navy {
        background: var(--navy);
        color: var(--white);
        box-shadow: 0 12px 28px -10px rgba(11,31,58,0.45);
    }



    /* HERO */
    .hero {
        background: radial-gradient(120% 140% at 18% 0%, #5A1015 0%, var(--navy) 45%, var(--navy-deep) 100%);
        position: relative;
        overflow: hidden;
        width: 100%;
    }

        .hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: repeating-linear-gradient(115deg, rgba(201,162,39,0.05) 0px, rgba(201,162,39,0.05) 1px, transparent 1px, transparent 64px);
            pointer-events: none;
        }

        .hero::after {
            content: '';
            position: absolute;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(201,162,39,0.22), transparent 70%);
            top: -180px;
            right: -160px;
            pointer-events: none;
        }

    .hero-grid {
        display: flex;
        grid-template-columns: 1.15fr 0.85fr;
        align-items: center;
        position: relative;
    }

    .hero .eyebrow {
        color: var(--gold-light);
    }

        .hero .eyebrow::before {
            background: var(--gold-light);
        }

    .hero h1 {
        color: var(--white);
        font-size: 46px;
        font-weight: 700;
        letter-spacing: -0.01em;
    }

        .hero h1 em {
            font-style: normal;
            color: var(--gold-light);
        }

    .hero .lead {
        color: #D9C9C9;
        font-size: 18px;
    }

    .hero-stats {
        display: flex;
        gap: 28px;
        margin-top: 40px;
        flex-wrap: wrap;
    }

    .hero-stat .num {
        font-family: 'Fraunces',serif;
        font-size: 34px;
        font-weight: 700;
        color: var(--gold-light);
    }

    .hero-stat .lab {
        font-size: 13px;
        color: #C9A6A6;
        margin-top: 2px;
    }





    /* STAT BAR */
    .statbar {
        background: var(--ivory);
        padding: 0;
    }

        .statbar .wrap {
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 0;
            padding: 0;
        }

    .stat-box {
        padding: 42px 24px;
        text-align: center;
        border-right: 1px solid var(--line);
    }

        .stat-box:last-child {
            border-right: none;
        }

        .stat-box .num {
            font-family: 'Fraunces',serif;
            font-size: 38px;
            font-weight: 700;
            color: var(--navy);
        }

            .stat-box .num span {
                color: var(--gold);
            }

        .stat-box .lab {
            font-size: 13.5px;
            color: var(--slate);
            margin-top: 6px;
        }

    /* SECTION HEAD */


    .sec-head h2 {
        font-size: 36px;
        font-weight: 700;
    }

    .sec-head.center {
        margin-left: auto;
        margin-right: auto;
        text-align: center;
    }

    /* WHY CHOOSE */

    .why-card {
        background: var(--white);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        box-shadow: var(--shadow-sm);
        transition: transform .2s ease;
    }

        .why-card:hover {
            transform: translateY(-4px);
        }

        .why-card .ico {
            width: 46px;
            height: 46px;
            border-radius: 12px;
            background: linear-gradient(135deg,var(--navy),#5A1015);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--gold-light);
            font-family: 'Fraunces',serif;
            font-weight: 700;
            font-size: 18px;
            margin-bottom: 16px;
        }

        .why-card h3 {
            font-size: 17px;
            font-weight: 600;
            font-family: 'Inter',sans-serif;
            color: var(--ink);
        }

        .why-card p {
            font-size: 14px;
            color: var(--slate);
            margin-top: 8px;
        }

    /* SUBJECTS */
    .subjects-sec {
        background: var(--navy-deep);
        color: var(--white);
    }

        .subjects-sec .sec-head h2 {
            color: var(--white);
        }

        .subjects-sec .sec-head .lead {
            color: #C9A6A6;
        }

    .subj-grid {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 18px;
    }

    .subj-card {
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: var(--radius);
        padding: 30px 22px;
    }

        .subj-card .idx {
            font-family: 'IBM Plex Mono',monospace;
            color: var(--gold-light);
            font-size: 13px;
        }

        .subj-card h3 {
            color: var(--white);
            font-size: 19px;
            margin-top: 14px;
            font-family: 'Fraunces',serif;
            font-weight: 600;
        }

        .subj-card p {
            color: #C9A6A6;
            font-size: 13.5px;
            margin-top: 8px;
        }

    /* EXAM PATTERN */
    .pattern-table {
        width: 100%;
        border-collapse: collapse;
        background: var(--white);
        border-radius: var(--radius);
        overflow: hidden;
        box-shadow: var(--shadow-sm);
    }

        .pattern-table th, .pattern-table td {
            padding: 16px 22px;
            text-align: left;
            border-bottom: 1px solid var(--line);
            font-size: 14.5px;
        }

        .pattern-table th {
            background: var(--navy);
            color: var(--white);
            font-family: 'Fraunces',serif;
            font-weight: 600;
            font-size: 15px;
        }

        .pattern-table tr:last-child td {
            border-bottom: none;
        }

        .pattern-table td:nth-child(2), .pattern-table td:nth-child(3) {
            font-family: 'IBM Plex Mono',monospace;
            font-size: 13.5px;
            color: var(--slate);
        }

    .pattern-note {
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
        margin-top: 18px;
    }

    .pattern-pill {
        background: var(--ivory);
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 8px 18px;
        font-size: 13px;
        color: var(--ink);
        font-weight: 600;
    }

    /* ELIGIBILITY */
    .elig-grid {
        display: grid;
        grid-template-columns: repeat(2,1fr);
        gap: 22px;
    }

    .elig-card {
        background: var(--white);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 28px;
        box-shadow: var(--shadow-sm);
    }

        .elig-card .route {
            font-family: 'IBM Plex Mono',monospace;
            font-size: 12px;
            color: var(--gold);
            letter-spacing: .08em;
            text-transform: uppercase;
        }

        .elig-card h3 {
            font-size: 19px;
            margin-top: 8px;
        }

        .elig-card ul {
            margin: 14px 0 0;
            padding-left: 20px;
            color: var(--slate);
            font-size: 14px;
        }

        .elig-card li {
            margin-bottom: 6px;
        }

    /* SYLLABUS ACCORDION (reuses faq-item visual language) */
    .syllabus-sec {
        background: var(--ivory);
    }

    /* STUDY PLAN TIMELINE */
    .plan-sec {
        background: var(--navy-deep);
    }

        .plan-sec .sec-head h2 {
            color: var(--white);
        }

        .plan-sec .sec-head .lead {
            color: #D9C9C9;
        }

    .plan-track {
        position: relative;
        padding-left: 36px;
    }

        .plan-track::before {
            content: '';
            position: absolute;
            left: 9px;
            top: 6px;
            bottom: 6px;
            width: 2px;
            background: rgba(255,255,255,0.18);
        }

    .plan-step {
        position: relative;
        padding-bottom: 34px;
    }

        .plan-step:last-child {
            padding-bottom: 0;
        }

        .plan-step::before {
            content: attr(data-step);
            position: absolute;
            left: -36px;
            top: 0;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: var(--gold);
            color: var(--navy-deep);
            font-family: 'IBM Plex Mono',monospace;
            font-size: 11px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .plan-step h3 {
            color: var(--white);
            font-size: 17px;
            font-family: 'Inter',sans-serif;
            font-weight: 600;
        }

        .plan-step .when {
            font-family: 'IBM Plex Mono',monospace;
            font-size: 12px;
            color: var(--gold-light);
            margin-top: 2px;
            display: block;
        }

        .plan-step p {
            color: #C9A6A6;
            font-size: 14px;
            margin-top: 8px;
            max-width: 560px;
        }

    /* CAREER OPPORTUNITIES */
    .career-grid {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 20px;
    }

    .career-card {
        background: var(--white);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 26px;
        box-shadow: var(--shadow-sm);
    }

        .career-card h3 {
            font-size: 17px;
            font-family: 'Inter',sans-serif;
            font-weight: 600;
        }

        .career-card p {
            font-size: 14px;
            color: var(--slate);
            margin-top: 8px;
        }

    /* RESULTS LEDGER — signature element */
    .ledger-sec {
        background: var(--ivory);
    }

    .ledger {
        background: var(--white);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        border: 1px solid var(--line);
        overflow: hidden;
    }

    .ledger-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: 30px 36px;
        border-bottom: 2px solid var(--navy);
    }

        .ledger-top .org {
            font-family: 'Fraunces',serif;
            font-weight: 700;
            font-size: 20px;
            color: var(--navy);
        }

        .ledger-top .doc-id {
            font-family: 'IBM Plex Mono',monospace;
            font-size: 12px;
            color: var(--slate);
            text-align: right;
        }

    .ledger-row {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr;
        align-items: center;
        padding: 22px 36px;
        border-bottom: 1px solid var(--line);
    }

        .ledger-row:last-child {
            border-bottom: none;
        }

        .ledger-row .label {
            font-weight: 600;
            color: var(--ink);
            font-size: 15.5px;
        }

            .ledger-row .label small {
                display: block;
                font-weight: 400;
                color: var(--slate);
                font-size: 13px;
                margin-top: 2px;
            }

        .ledger-row .pct {
            font-family: 'IBM Plex Mono',monospace;
            font-size: 26px;
            font-weight: 600;
            color: var(--slate);
            text-align: center;
        }

        .ledger-row.highlight {
            background: linear-gradient(90deg, rgba(201,162,39,0.06), transparent);
        }

            .ledger-row.highlight .pct {
                color: var(--green);
            }

    .pct-bar {
        height: 8px;
        border-radius: 6px;
        background: var(--line);
        overflow: hidden;
        margin: 0 36px 24px;
    }

    .pct-bar-inner {
        height: 100%;
        border-radius: 6px;
    }

        .pct-bar-inner.all-india {
            width: 14.05%;
            background: var(--slate);
        }

        .pct-bar-inner.excel {
            width: 42.8%;
            background: linear-gradient(90deg,var(--gold),var(--green));
        }

    .stamp {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(30,122,76,0.1);
        color: var(--green);
        border: 1.5px solid var(--green);
        border-radius: 999px;
        padding: 6px 16px;
        font-family: 'IBM Plex Mono',monospace;
        font-size: 12.5px;
        font-weight: 600;
        letter-spacing: .04em;
        margin: 24px 36px 0;
    }

    /* FACULTY */
    /* FACULTY */
    .faculty-photo {
        width: 100%;
        height: 240px;
        overflow: hidden;
        background: #f5f5f5;
    }

        .faculty-photo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: transform .4s ease;
        }

    .faculty-card:hover .faculty-photo img {
        transform: scale(1.05);
    }

    .faculty-grid {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 20px;
    }

    .faculty-card {
        background: var(--white);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        overflow: hidden;
        box-shadow: var(--shadow-sm);
    }


    .faculty-body {
        padding: 22px;
    }

        .faculty-body h3 {
            font-size: 18px;
            font-weight: 600;
            font-family: 'Inter',sans-serif;
        }

        .faculty-body .role {
            font-size: 13px;
            color: var(--gold);
            font-weight: 600;
            margin-top: 2px;
        }

        .faculty-body .exp {
            display: inline-block;
            margin-top: 14px;
            background: var(--ivory);
            border-radius: 8px;
            padding: 6px 12px;
            font-family: 'IBM Plex Mono',monospace;
            font-size: 12.5px;
            color: var(--navy);
            font-weight: 600;
        }

    /* AWARDS */
    .awards-grid {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 20px;
    }

    .award-card {
        background: var(--white);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 30px;
        text-align: center;
        box-shadow: var(--shadow-sm);
    }

        .award-card .medal {
            width: 54px;
            height: 54px;
            border-radius: 50%;
            background: linear-gradient(135deg,var(--gold-light),var(--gold));
            margin: 0 auto 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--navy-deep);
            font-weight: 700;
            font-family: 'Fraunces',serif;
        }

        .award-card h3 {
            font-size: 16.5px;
            font-weight: 600;
            font-family: 'Inter',sans-serif;
        }

        .award-card p {
            font-size: 13px;
            color: var(--slate);
            margin-top: 8px;
        }

    /* TESTIMONIALS */
    .testi-sec {
        background: var(--ivory);
    }

    .testi-grid {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 22px;
    }

    .testi-card {
        background: var(--white);
        border-radius: var(--radius);
        padding: 28px;
        border: 1px solid var(--line);
        box-shadow: var(--shadow-sm);
        display: flex;
        flex-direction: column;
        height: 100%;
    }

        .testi-card .quote {
            font-size: 14.5px;
            color: var(--ink);
            line-height: 1.7;
            flex: 1;
        }

    .testi-foot {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 20px;
        padding-top: 16px;
        border-top: 1px solid var(--line);
    }

    .avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: linear-gradient(135deg,var(--navy),#5A1015);
        color: var(--gold-light);
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Fraunces',serif;
        font-weight: 700;
        font-size: 15px;
    }

    .testi-foot .nm {
        font-weight: 600;
        font-size: 14px;
    }

    .testi-foot .rk {
        font-size: 12px;
        color: var(--gold);
        font-weight: 600;
    }

    /* COMPARISON TABLE */
    .comp-table {
        width: 100%;
        border-collapse: collapse;
        background: var(--white);
        border-radius: var(--radius);
        overflow: hidden;
        box-shadow: var(--shadow-sm);
    }

        .comp-table th, .comp-table td {
            padding: 18px 24px;
            text-align: center;
            border-bottom: 1px solid var(--line);
            font-size: 14.5px;
        }

        .comp-table th {
            background: var(--navy);
            color: var(--white);
            font-family: 'Fraunces',serif;
            font-weight: 600;
            font-size: 15px;
        }

            .comp-table td:first-child, .comp-table th:first-child {
                text-align: left;
                font-weight: 600;
            }

        .comp-table tr:last-child td {
            border-bottom: none;
        }

    .yes {
        color: var(--green);
        font-weight: 700;
    }

    .no {
        color: #C24545;
        font-weight: 700;
    }

    .limited {
        color: var(--slate);
        font-size: 13px;
    }

    /* FAQ */
    .faq-sec {
        background: var(--ivory);
    }

    .faq-item {
        background: var(--white);
        border: 1px solid var(--line);
        border-radius: 14px;
        margin-bottom: 12px;
        overflow: hidden;
    }

    .faq-q {
        padding: 20px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        cursor: pointer;
        font-weight: 600;
        font-size: 15.5px;
    }

        .faq-q .plus {
            font-family: 'IBM Plex Mono',monospace;
            color: var(--gold);
            font-size: 20px;
            transition: transform .2s ease;
            flex-shrink: 0;
            margin-left: 16px;
        }

    .faq-item.open .plus {
        transform: rotate(45deg);
    }

    .faq-a {
        padding: 0 24px;
        max-height: 0;
        overflow: hidden;
        transition: max-height .25s ease, padding .25s ease;
        color: var(--slate);
        font-size: 14.5px;
    }

    .faq-item.open .faq-a {
        padding: 0 24px 22px;
    }

    /* FINAL CTA */
    .final-cta {
        background: radial-gradient(120% 140% at 80% 100%, #5A1015 0%, var(--navy) 45%, var(--navy-deep) 100%);
        text-align: center;
        position: relative;
        overflow: hidden;
    }

        .final-cta h2 {
            color: var(--white);
            font-size: 38px;
        }

        .final-cta .lead {
            color: #D9C9C9;
            margin: 18px auto 0;
        }

        .final-cta .cta-row {
            justify-content: center;
        }

    .internal-links {
        display: flex;
        gap: 18px;
        flex-wrap: wrap;
        justify-content: center;
        margin-top: 36px;
        font-size: 13px;
    }

        .internal-links a {
            color: #B98C8C;
