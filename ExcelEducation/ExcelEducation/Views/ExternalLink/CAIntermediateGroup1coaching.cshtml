    .section-title {
        font-weight: 700;
        margin-bottom: 40px;
        position: relative;
    }

        .section-title::after {
            content: '';
            width: 60px;
            height: 4px;
            background: var(--primary-color);
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
        }

    .highlight-text {
        color: var(--primary-color);
