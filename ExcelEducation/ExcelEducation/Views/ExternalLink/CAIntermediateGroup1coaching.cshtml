        text-transform: uppercase;
        letter-spacing: 1px;
    }

        .btn-enroll:hover {
            background: #f8f9fa;
            color: var(--secondary-color);
            transform: scale(1.05);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
