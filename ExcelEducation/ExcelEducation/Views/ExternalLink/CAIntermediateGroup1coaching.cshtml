                    </ul>
                </div>
            </div>

            <!-- Subject 3 -->
            <div class="col-md-4 mb-4">
                <div class="glass-card shadow-sm">
                    <div class="subject-icon">💰</div>
                    <h4 class="fw-bold">Taxation</h4>
                    <p class="text-muted"><span class="highlight-text">Personalized</span> guidance latest amendments ke saath.</p>
                    <ul class="list-unstyled text-start">
                        <li>✅ Conceptual Clarity Guaranteed</li>
                        <li>✅ Weekly <span class="fw-bold">Top</span> Mock Tests</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Features Section -->
        <div class="row mt-5 g-4 text-center">
            <div class="col-12 mb-2">
                <h2 class="fw-bold">Trusted by Thousands of Students</h2>
                <p>Humari <span class="highlight-text">Live & Interactive</span> coaching ki visheshitayein</p>
            </div>

            <div class="col-md-3">
                <div class="p-4 border rounded-4 bg-white h-100">
                    <i class="bi bi-play-circle-fill text-primary mb-3 d-block" style="font-size: 2.5rem;"></i>
                    <h5 class="fw-bold">Live Classes</h5>
                    <p class="small text-muted">Join Live classes with 24/7 Recorded Backup.</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-4 border rounded-4 bg-white h-100">
                    <i class="bi bi-mortarboard-fill text-primary mb-3 d-block" style="font-size: 2.5rem;"></i>
                    <h5 class="fw-bold">Scholarship</h5>
                    <p class="small text-muted">Affordable fees with merit-based scholarship options.</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-4 border rounded-4 bg-white h-100">
                    <i class="bi bi-person-workspace text-primary mb-3 d-block" style="font-size: 2.5rem;"></i>
                    <h5 class="fw-bold">Expert Guidance</h5>
                    <p class="small text-muted">Talk to Counselor for free career roadmap.</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-4 border rounded-4 bg-white h-100">
                    <i class="bi bi-trophy-fill text-primary mb-3 d-block" style="font-size: 2.5rem;"></i>
                    <h5 class="fw-bold">Successful Path</h5>
                    <p class="small text-muted">Join New Batch & start your journey to CA.</p>
                </div>
            </div>
        </div>

        <!-- Call to Action Section -->
        <div class="row mt-5">
            <div class="col-12 text-center p-5 bg-dark text-white rounded-5 shadow-lg">
                <h2 class="fw-bold mb-3">Ready to Start Preparation?</h2>
                <p class="mb-4">Reserve Your Seat today and get access to exclusive study material.</p>
                <div class="d-flex flex-wrap justify-content-center gap-3">
                    <a href="#" class="btn btn-primary btn-lg px-5 rounded-pill">Successful Apply Now</a>
                    <a href="#" class="btn btn-outline-light btn-lg px-5 rounded-pill">Download Brochure</a>
                </div>
                <p class="mt-4 mb-0"><i class="bi bi-telephone-outbound"></i> Need help? <span class="text-warning">Get Free Guidance</span> from our mentors.</p>
            </div>
        </div>
    </div>
</div>