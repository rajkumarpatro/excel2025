@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Best Class 11 Commerce Coaching | Excel Educational Institution";
    ViewData["Description"] = "Building a strong foundation for CA, CS, and CMA. Join the best Class 11 Commerce coaching for Accounts, Economics, and Business Studies.";
    ViewData["Keywords"] = "Class 11 Commerce coaching, Best Accounts classes for 11th, Commerce coaching near me, XI Commerce tuition, Excel Education Commerce";
}

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --comm-blue: #2c3e50;
        --comm-green: #27ae60;
        --glass-bg: rgba(255, 255, 255, 0.8);
        --glass-border: rgba(255, 255, 255, 0.4);
    }

    body {
        font-family: 'Poppins', sans-serif;
        background-color: #f4f7f6;
    }

    /* Hero Section - Building Foundations */
    .hero-commerce {
        background: linear-gradient(135deg, var(--comm-blue) 0%, #1a252f 100%);
        padding: 100px 0;
        color: white;
        border-radius: 0 0 80px 0;
        position: relative;
        overflow: hidden;
    }

    /* Glassmorphism Feature Cards */
    .glass-card {
        background: var(--glass-bg);
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        border: 1px solid var(--glass-border);
        border-radius: 25px;
        padding: 35px;
        transition: all 0.4s ease;
        height: 100%;
        box-shadow: 0 15px 30px rgba(0,0,0,0.05);
    }

        .glass-card:hover {
            transform: translateY(-10px);
            background: #ffffff;
            border-color: var(--comm-green);
        }

    .icon-box {
        width: 60px;
        height: 60px;
        background: var(--comm-green);
        color: white;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
        font-size: 1.5rem;
    }

    .btn-action {
        background: var(--comm-green);
        color: white;
        font-weight: 700;
        padding: 15px 35px;
        border-radius: 50px;
        border: none;
        transition: 0.3s;
    }

        .btn-action:hover {
            background: #219150;
            box-shadow: 0 10px 20px rgba(39, 174, 96, 0.3);
            color: white;
        }
</style>

<div class="container-fluid p-0">
