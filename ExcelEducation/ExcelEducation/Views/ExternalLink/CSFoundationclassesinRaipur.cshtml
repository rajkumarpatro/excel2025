<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --raipur-maroon: #660000; /* Professional CS Identity */
        --raipur-gold: #b8860b;
        --glass-bg: rgba(255, 255, 255, 0.7);
        --glass-border: rgba(255, 255, 255, 0.3);
    }

    body {
        font-family: 'Poppins', sans-serif;
        background-color: #fdfdfd;
        color: #222;
    }

    /* Animated Hero Section */
    .hero-raipur {
        background: linear-gradient(135deg, var(--raipur-maroon) 0%, #330000 100%);
        padding: 120px 0;
        color: white;
        border-radius: 0 0 120px 0;
        position: relative;
        overflow: hidden;
    }

        .hero-raipur::before {
            content: "";
            position: absolute;
            top: -10%;
            left: -10%;
            width: 50%;
            height: 120%;
            background: radial-gradient(circle, rgba(184, 134, 11, 0.2) 0%, transparent 60%);
            animation: pulse-glow 8s infinite alternate;
        }

    @@keyframes pulse-glow {
        from {
            opacity: 0.3;
            transform: scale(1);
        }

        to {
            opacity: 0.7;
            transform: scale(1.1);
        }
    }

    /* Glassmorphism Cards */
    .glass-card {
        background: var(--glass-bg);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid var(--glass-border);
        border-radius: 30px;
        padding: 40px;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        height: 100%;
        box-shadow: 0 15px 35px rgba(0,0,0,0.05);
    }

        .glass-card:hover {
            transform: translateY(-15px);
            background: #ffffff;
            box-shadow: 0 25px 50px rgba(102, 0, 0, 0.1);
            border-color: var(--raipur-gold);
        }

    .icon-box {
        width: 70px;
        height: 70px;
        background: var(--raipur-maroon);
        color: white;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 25px;
        font-size: 1.8rem;
        box-shadow: 0 10px 20px rgba(102, 0, 0, 0.3);
    }

    /* Professional Buttons */
    .btn-raipur {
        background: var(--raipur-gold);
        color: white;
        font-weight: 700;
        padding: 15px 40px;
        border-radius: 50px;
        text-transform: uppercase;
        border: none;
        transition: 0.3s;
        letter-spacing: 1px;
    }

        .btn-raipur:hover {
            background: #966d09;
            box-shadow: 0 10px 20px rgba(184, 134, 11, 0.4);
            transform: scale(1.05);
            color: white;
        }

    .contact-bubble {
        background: #f8f9fa;
        border-left: 5px solid var(--raipur-gold);
        padding: 15px;
        border-radius: 10px;
        margin-bottom: 15px;
        transition: 0.3s;
    }

        .contact-bubble:hover {
            background: #fff;
            transform: translateX(10px);
        }
</style>

