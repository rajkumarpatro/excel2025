<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>

    .timeline-section {
        max-width: 1100px;
        margin: auto;
        padding: 40px 20px;
        position: relative;
    }

    .timeline-heading {
        text-align: center;
        font-size: 28px;
        font-weight: bold;
        margin-bottom: 40px;
    }

    .timeline-container {
        position: relative;
        padding: 20px 0;
    }

        .timeline-container::before {
            content: '';
            position: absolute;
            width: 4px;
            background-color: #e0e0e0;
            top: 0;
            bottom: 0;
            left: 50%;
            margin-left: -2px;
        }

    .timeline-item {
        padding: 15px 30px;
        position: relative;
        width: 50%;
    }

        .timeline-item::after {
            content: "";
            position: absolute;
            width: 18px;
            height: 18px;
            right: -9px;
            background-color: #d60000;
            border: 3px solid white;
            top: 20px;
            border-radius: 50%;
            z-index: 1;
        }

        .timeline-item.left {
            left: 0;
            text-align: right;
        }

        .timeline-item.right {
            left: 50%;
            text-align: left;
        }

            .timeline-item.right::after {
                left: -9px;
            }

        .timeline-item .content {
            background-color: #fafafa;
            padding: 15px 20px;
            border-radius: 6px;
            position: relative;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        }

            .timeline-item .content h3 {
                margin: 0 0 5px;
                color: #d60000;
                font-size: 18px;
            }

            .timeline-item .content p {
                margin: 0;
                color: #222;
            }




    .video-two.shadow-overlay {
        position: relative;
        z-index: 0;
    }

        .video-two.shadow-overlay::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            height: 100%;
            width: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 1;
        }

        .video-two.shadow-overlay > * {
            position: relative;
            z-index: 2;
        }
</style>

