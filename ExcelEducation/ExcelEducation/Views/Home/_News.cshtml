@model List<DAL.Models.LatestUpdatesModel>

@if (Model != null && Model.Any())
{
    <marquee behavior="scroll" direction="left" style="color:#ffffff;">
        @foreach (var news in Model)
        {
            <span style="margin-right:30px;">
                <img src="~/Content/home/images/newRed.png" alt="New" />

                <strong>
                    @news.NEWS_DAY-@news.NEWS_MONTH-@news.NEWS_YEAR
                </strong>

                @news.NEWS_TITLE

                @if (!string.Equals(news.NEWS_LINKTYPE, "Text", StringComparison.OrdinalIgnoreCase))
                {
                    var link = !string.IsNullOrEmpty(news.NEWS_FILEPATH)
                                ? news.NEWS_FILEPATH
                                : news.NEWS_LINK;

                    if (!string.IsNullOrEmpty(link))
                    {
                        <a href="@link" target="_blank" style="color:#ffd700; margin-left:5px;">
                            View Details
                        </a>
                    }
                }
            </span>
        }
    </marquee>
}
