@model DAL.Models.ExcelInfoModel

@{
    ViewBag.Title = "Page";
}

<!-- breadcrumb area end -->
<section class="page-header page-header--bg-two" data-jarallax data-speed="0.3" data-imgPosition="50% -100%">
    <div class="page-header__bg jarallax-img"></div>
    <!-- /.page-header-bg -->
    <div class="page-header__overlay"></div>
    <!-- /.page-header-overlay -->
    <div class="container text-center">
        <h2 class="page-header__title">@Model.page</h2>
        <!-- /.page-breadcrumb list-unstyled -->
    </div>
    <!-- /.container -->
</section>

<!-- profile menu area start -->
<!--------28/08/25 tetsing start------->
<section class="service-two" style="background-image: url('/Content/home/images/shapes/team-bg-2.png');">
    <div class="container">

        <div class="row">
            @{
                string columns = "col-xxl-12 col-md-12";
                var topics = Model.Topics;
                var firstTopicId = Model.Topics.FirstOrDefault().TOPIC_ID;
                int topicCount = Model.Topics.Count();

                if (topicCount > 1)
                {
                    columns = "col-xl-9 col-lg-8";
                <div class="col-xl-3 col-lg-4 wow fadeInLeft" data-wow-delay="200ms">
                    <div class="product__sidebar product__sidebar--left">
                        <!-- /.price-slider -->
                        <div class="product__sidebar__single product__categories">
                            <h3 class="product__sidebar__title"> Major Topics</h3>
                            <ul class="list-unstyled">
                                @foreach (var topic in topics)
                                                {
                                <li id="lnk_topicdetails" data-topicid="@topic.TOPIC_ID">@topic.TOPIC_NAME</li>
                                                }
                            </ul>
                        </div>
                        <!-- /.category-widget -->
                    </div>
                    <!-- /.shop-sidebar -->
                </div>
 <!-- /.column -->

                }
            }

            <div class="@columns">
                <div class="product__sidebar__single product__categories">
                    <div class="product__info-top wow fadeInUp" data-wow-delay="200ms">
                        <div class="product__showing-text-box">
                            <div class="topic-content"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!--------tetsing End------->
@*Custom Js*@

<script src="@Url.Content("~/Scripts/custom/ExcelInfo/PageContent.js")"></script>

<script>
    var LoadPageContent = "@Url.Content("~/ExcelInfo/LoadPageContents")";
    var firstTopicID = @firstTopicId;


</script>

<style>
    .product__sidebar {
        background: #fff; /* pure white for clean contrast */
        padding: 10px;
        border-radius: 8px;
        width: 300px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        box-shadow: 0 2px 6px rgba(128, 0, 0, 0.15); /* subtle maroon shadow */
    }

    .product__sidebar__title {
        font-size: 1.5rem;
        color: #800000; /* maroon */
        margin-bottom: 15px;
        border-bottom: 2px solid #800000;
        padding-bottom: 8px;
        font-weight: 600;
    }

    .product__categories ul {
        list-style: none;
        padding-left: 0;
    }

    .product__categories li {
        position: relative;
        padding: 10px 15px;
        margin-bottom: 8px;
        border-radius: 5px;
        cursor: pointer;
        color: #800000;
        transition: background-color 0.3s ease, color 0.3s ease;
    }

        .product__categories li::after {
            content: "→";
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #800000;
            font-weight: bold;
            transition: right 0.3s ease;
        }

        .product__categories li:hover {
            background-color: #800000;
            color: #fff;
        }

            .product__categories li:hover::after {
                right: 10px;
                color: #fff;
            }

    </style>
<!-- profile menu area end -->